@model List<Invoice>
@{
    var counts = (Dictionary<InvoiceStatus, int>)ViewBag.Counts; var st = (InvoiceStatus?)ViewBag.Status; bool overdue = ViewBag.Overdue;
    var uninvoiced = (List<(PurchaseOrder Po, decimal Remaining)>)ViewBag.Uninvoiced;
    var finance = User.IsAdmin() || User.IsInRole(AppRoles.Accountant);
}
<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-action="Index" class="btn btn-sm @(st == null && !overdue ? "btn-primary" : "btn-outline-primary")">Tất cả</a>
    @foreach (var s in Enum.GetValues<InvoiceStatus>())
    {
        <a asp-action="Index" asp-route-status="@s" class="btn btn-sm @(st == s ? "btn-primary" : "btn-outline-primary")">@s.GetDisplayName() <span class="badge bg-light text-dark">@counts.GetValueOrDefault(s)</span></a>
    }
    <a asp-action="Index" asp-route-overdue="true" class="btn btn-sm @(overdue ? "btn-danger" : "btn-outline-danger")">Quá hạn thanh toán</a>
</div>
<div class="row g-3">
    <div class="col-xl-8">
        <div class="card"><div class="card-body p-0"><div class="table-responsive"><table class="table mb-0 align-middle">
            <thead><tr><th>Số</th><th>Nhà cung cấp</th><th>Hóa đơn</th><th>PO</th><th class="money">Tổng thanh toán</th><th>Hạn TT</th><th>Trạng thái</th></tr></thead><tbody>
            @foreach (var i in Model)
            {
                var od = i.Status is not (InvoiceStatus.Paid or InvoiceStatus.Rejected) && i.DueDate < DateTime.Today;
                <tr><td><a asp-action="Details" asp-route-id="@i.Id" class="fw-semibold">@i.Number</a>@if (i.FromPortal) { <div><span class="badge bg-info-subtle text-info">Cổng NCC</span></div> }</td>
                    <td class="small">@i.Vendor?.Name</td><td class="small">@i.Series @i.InvoiceNo<div class="text-muted">@i.InvoiceDate.ToDate()</div></td>
                    <td class="small"><a asp-controller="PurchaseOrders" asp-action="Details" asp-route-id="@i.PurchaseOrderId">@i.PurchaseOrder?.Number</a></td>
                    <td class="money">@i.Total.ToMoney()</td><td class="small @(od ? "text-danger fw-semibold" : "")">@i.DueDate.ToDate()</td>
                    <td><span class="badge @(i.Status switch { InvoiceStatus.Exception => "bg-danger", InvoiceStatus.Matched => "bg-primary", InvoiceStatus.Paid => "bg-success", InvoiceStatus.Rejected => "bg-secondary", _ => "bg-warning text-dark" })">@i.Status.GetDisplayName()</span></td></tr>
            }
            @if (!Model.Any()) { <tr><td colspan="7" class="text-muted p-3">Không có hóa đơn.</td></tr> }
            </tbody></table></div></div></div>
    </div>
    <div class="col-xl-4">
        <div class="card"><div class="card-header">PO đã nhận hàng – chưa có hóa đơn đủ</div><div class="list-group list-group-flush small">
            @foreach (var (po, rem) in uninvoiced.Take(25))
            {
                <div class="list-group-item d-flex justify-content-between align-items-center gap-2">
                    <span><a asp-controller="PurchaseOrders" asp-action="Details" asp-route-id="@po.Id">@po.Number</a> · @po.Vendor?.Name<div class="text-muted">còn @rem.ToMoney() đ (trước VAT)</div></span>
                    @if (finance) { <a asp-action="Create" asp-route-poId="@po.Id" class="btn btn-sm btn-outline-primary text-nowrap">Nhận HĐ</a> }
                </div>
            }
            @if (!uninvoiced.Any()) { <div class="list-group-item text-muted">Không có.</div> }
        </div></div>
    </div>
</div>

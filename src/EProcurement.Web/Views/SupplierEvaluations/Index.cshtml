@model List<SupplierScore>
@{
    ViewData["Title"] = "Đánh giá nhà cung cấp";
    DateTime from = ViewBag.From, to = ViewBag.To; var grade = ViewBag.Grade as string; var counts = (Dictionary<string, int>)ViewBag.Counts;
    var cats = (List<Category>)ViewBag.Categories; var catId = ViewBag.CategoryId as int?; string period = ViewBag.Period; var periodic = (List<int>)ViewBag.Periodic;
    var levels = (List<GradeLevel>)ViewBag.Levels; var palette = new[] { "bg-success", "bg-primary", "bg-warning text-dark", "bg-danger" };
    string Css(string g) { var i = levels.FindIndex(l => l.Code == g); return i < 0 ? "bg-light text-muted border" : palette[Math.Min(i, palette.Length - 1)]; }
}
<div class="row g-3 mb-3">
    @foreach (var g in levels.Select(l => l.Code))
    {
        <div class="col-6 col-md-3"><a asp-action="Index" asp-route-grade="@(grade == g ? null : g)" asp-route-from="@from.ToString("yyyy-MM-dd")" asp-route-to="@to.ToString("yyyy-MM-dd")" asp-route-categoryId="@catId" class="card stat text-decoration-none text-reset @(grade == g ? "border-primary" : "")">
            <div class="label"><span class="badge @Css(g)">@L["Loại"] @g</span> @SupplierScorecard.GradeText(g, levels)</div><div class="value">@counts.GetValueOrDefault(g)</div></a></div>
    }
</div>
<form method="get" class="toolbar">
    <label class="small">@L["Từ"]</label><input type="date" name="from" value="@from.ToString("yyyy-MM-dd")" class="form-control form-control-sm" style="width:auto" />
    <label class="small">@L["đến"]</label><input type="date" name="to" value="@to.ToString("yyyy-MM-dd")" class="form-control form-control-sm" style="width:auto" />
    <select name="categoryId" class="form-select form-select-sm" style="width:auto"><option value="">@L["-- Mọi nhóm hàng --"]</option>@foreach (var c in cats) { <option value="@c.Id" selected="@(catId == c.Id)">@c.Name</option> }</select>
    <input type="hidden" name="grade" value="@grade" />
    <button class="btn btn-sm btn-outline-secondary">Xem</button>
    <span class="small text-muted ms-auto">Điểm = TB phiếu đánh giá (sau giao hàng + định kỳ); chưa có phiếu: suy từ % đúng hạn và % hàng không đạt. Thang: @string.Join(" · ", levels.Select(l => $"{l.Code} ≥ {l.Min:0.##}")) (<a asp-controller="Catalogs" asp-action="Index" asp-route-type="SupplierGrade">@L["danh mục Xếp loại"]</a>)</span>
</form>
<div class="card"><div class="card-body p-0"><div class="table-responsive"><table class="table mb-0 align-middle">
    <thead><tr><th>@L["Nhà cung cấp"]</th><th class="money">@L["Số PO"]</th><th class="money">@L["Giá trị"]</th><th class="money">@L["% đúng hạn"]</th><th class="money">@L["% không đạt"]</th>
        <th class="money">@L["Chất lượng"]</th><th class="money">@L["Tiến độ"]</th><th class="money">@L["Giá"]</th><th class="money">@L["Dịch vụ"]</th><th class="money">@L["Điểm"]</th><th>@L["Xếp loại"]</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr><td><a asp-controller="Vendors" asp-action="Details" asp-route-id="@r.Vendor.Id" class="fw-semibold">@r.Vendor.Name</a>
                <div class="small text-muted">@r.Vendor.Code · @r.Vendor.Status.GetDisplayName() · @r.Evaluations @L["phiếu"]</div></td>
            <td class="money">@r.Orders</td><td class="money">@r.Value.ToShortMoney()</td>
            <td class="money @(r.OnTimePercent < 80 ? "text-danger" : "")">@(r.OnTimePercent?.ToString("0.#") + (r.OnTimePercent.HasValue ? "%" : ""))</td>
            <td class="money @(r.RejectPercent > 5 ? "text-danger" : "")">@(r.RejectPercent?.ToString("0.#") + (r.RejectPercent.HasValue ? "%" : ""))</td>
            <td class="money">@r.Quality?.ToString("0.0")</td><td class="money">@r.Delivery?.ToString("0.0")</td><td class="money">@r.Price?.ToString("0.0")</td><td class="money">@r.Service?.ToString("0.0")</td>
            <td class="money fw-bold">@r.Score?.ToString("0.00")</td>
            <td><span class="badge @Css(r.Grade)" title="@r.GradeLabel">@r.Grade</span></td>
            <td class="text-end text-nowrap">@if (User.IsPurchasing()) { <a asp-action="Evaluate" asp-route-vendorId="@r.Vendor.Id" class="btn btn-sm @(periodic.Contains(r.Vendor.Id) ? "btn-outline-secondary" : "btn-outline-primary")">@(periodic.Contains(r.Vendor.Id) ? L["Đã đánh giá {0}", period] : L["Đánh giá {0}", period])</a> }</td></tr>
    }
    @if (!Model.Any()) { <tr><td colspan="12" class="text-muted p-3">@L["Không có nhà cung cấp phát sinh giao dịch trong kỳ."]</td></tr> }
    </tbody>
</table></div></div></div>

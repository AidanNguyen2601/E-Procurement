@model Prequalification
@inject SettingsStore SettingsDb
@{
    ViewData["Title"] = $"Kết quả sơ tuyển {Model.Number}";
    var apps = Model.Applications.Where(a => a.Status != PrequalificationResult.Withdrawn).OrderByDescending(a => a.Status == PrequalificationResult.Passed).ThenByDescending(a => a.TotalScore).ToList();
}
<div class="toolbar no-print"><button class="btn btn-outline-secondary" onclick="window.print()">@L["In / Lưu PDF"]</button></div>
<div class="card paper mb-4"><div class="card-body p-4">@{ var printCfg = await SettingsDb.GetAsync(SettingsStore.Print, () => new PrintSettings()); }<partial name="_PrintHeader" model="printCfg" />
    <div class="text-center mb-3"><h4 class="mb-0">@L["BÁO CÁO KẾT QUẢ SƠ TUYỂN NHÀ CUNG CẤP"]</h4>
        <div>@Model.Title (@Model.Number@L[") · nhóm hàng:"] @Model.Category?.Name</div>
        <div class="text-muted">@L["Hạn nộp hồ sơ"] @Model.Deadline.ToDateTime()</div></div>
    <p class="mb-1"><b>@L["Tiêu chí:"]</b> @L["mọi tiêu chí bắt buộc đạt; điểm tiêu chí chấm điểm quy đổi thang 100, tối thiểu"] @Model.MinScore @L["điểm."]</p>
    <table class="table table-bordered table-sm small">
        <thead><tr><th>TT</th><th>@L["Nhà cung cấp"]</th><th>MST</th>@foreach (var c in Model.Criteria) { <th>@c.Name<div class="fw-normal">@(c.IsMandatory ? L["Đ/KĐ"] : $"/{c.MaxScore}")</div></th> }<th class="money">@L["Điểm"]</th><th>@L["Kết quả"]</th></tr></thead>
        <tbody>
        @for (var i = 0; i < apps.Count; i++)
        {
            var a = apps[i];
            <tr><td>@(i + 1)</td><td>@a.Vendor?.Name</td><td>@a.Vendor?.TaxCode</td>
                @foreach (var c in Model.Criteria) { var sc = a.Scores.FirstOrDefault(x => x.CriterionId == c.Id); <td>@(c.IsMandatory ? (sc?.Pass == true ? L["Đạt"] : sc?.Pass == false ? L["Không đạt"] : "") : sc?.Score?.ToString("0.##"))</td> }
                <td class="money">@a.TotalScore?.ToString("0.##")</td><td>@a.Status.GetDisplayName()@(string.IsNullOrEmpty(a.ResultNote) ? "" : " – " + a.ResultNote)</td></tr>
        }
        </tbody>
    </table>
    <p>@L["Số NCC đạt:"] <b>@apps.Count(a => a.Status == PrequalificationResult.Passed)/@apps.Count</b>@(Model.Status == PrequalificationStatus.Completed ? L[". Kết quả được Giám đốc phê duyệt ngày {0:dd/MM/yyyy}, hiệu lực {1} tháng.", Model.DecidedAt, Model.ValidityMonths] : ".")</p>
    <div class="row text-center mt-4 small">
        <div class="col">@L["NGƯỜI LẬP"]<br /><br /><br /><br />@Model.CreatedBy?.FullName</div>
        <div class="col">@L["GIÁM ĐỐC"]<br />@(Model.Status == PrequalificationStatus.Completed ? L["(đã ký điện tử {0:dd/MM/yyyy HH:mm})", Model.DecidedAt] : "")<br /><br /><br />@Model.DecidedBy?.FullName</div>
    </div>
    @if (printCfg.Footer != null) { <div class="small text-muted text-end border-top mt-4 pt-1">@printCfg.Footer</div> }
</div></div>

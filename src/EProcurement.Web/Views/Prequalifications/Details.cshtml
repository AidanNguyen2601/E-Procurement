@model Prequalification
@{
    ViewData["Title"] = $"Sơ tuyển {Model.Number}";
    var history = (List<ApprovalHistory>)ViewBag.History; bool canDecide = ViewBag.CanDecide;
    var buyer = User.IsPurchasing(); var s = Model.Status; var now = DateTime.Now;
    var apps = Model.Applications.OrderBy(a => a.Status == PrequalificationResult.Withdrawn).ThenByDescending(a => a.TotalScore).ThenBy(a => a.Vendor?.Name).ToList();
    var steps = new (string Name, bool Done, bool Current)[]
    {
        ("Lập & đăng tải", s >= PrequalificationStatus.Open && s != PrequalificationStatus.Cancelled, s == PrequalificationStatus.Draft),
        ("Nhận hồ sơ", s >= PrequalificationStatus.Evaluating && s != PrequalificationStatus.Cancelled, s == PrequalificationStatus.Open),
        ("Đánh giá", s >= PrequalificationStatus.PendingApproval && s != PrequalificationStatus.Cancelled, s == PrequalificationStatus.Evaluating),
        ("Giám đốc duyệt", s == PrequalificationStatus.Completed, s == PrequalificationStatus.PendingApproval),
    };
}
<div class="card mb-3"><div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div class="flow">
        @for (var i = 0; i < steps.Length; i++) { <span class="step @(steps[i].Done ? "done" : steps[i].Current ? "current" : "")">@steps[i].Name</span> @if (i < steps.Length - 1) { <span class="arrow">›</span> } }
    </div>
    <span class="badge bg-light text-dark border">@s.GetDisplayName()</span>
</div></div>

<div class="toolbar">
    @if (buyer && s == PrequalificationStatus.Draft)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Sửa</a>
        <form asp-action="Publish" asp-route-id="@Model.Id" method="post" data-confirm="Đăng tải thông báo mời sơ tuyển trên cổng NCC?"><button class="btn btn-primary">Đăng tải mời sơ tuyển</button></form>
    }
    @if (buyer && s == PrequalificationStatus.Open && now >= Model.Deadline) { <form asp-action="Close" asp-route-id="@Model.Id" method="post"><button class="btn btn-primary">Đóng nhận hồ sơ – đánh giá</button></form> }
    @if (buyer && s == PrequalificationStatus.Evaluating) { <form asp-action="SubmitResult" asp-route-id="@Model.Id" method="post" data-confirm="Trình Giám đốc phê duyệt kết quả sơ tuyển?"><button class="btn btn-primary">Trình duyệt kết quả</button></form> }
    @if (s >= PrequalificationStatus.Evaluating) { <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-secondary">In báo cáo kết quả</a> }
    @if (buyer && s is not (PrequalificationStatus.Completed or PrequalificationStatus.Cancelled))
    {
        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="ms-auto d-flex gap-1" data-confirm="Hủy đợt sơ tuyển?">
            <input name="reason" class="form-control form-control-sm" placeholder="Lý do hủy" /><button class="btn btn-sm btn-outline-danger text-nowrap">Hủy</button></form>
    }
</div>

@if (canDecide)
{
    <div class="card mb-3 border-warning"><div class="card-body">
        <div class="fw-semibold mb-2">Phê duyệt kết quả sơ tuyển: @apps.Count(a => a.Status == PrequalificationResult.Passed)/@apps.Count(a => a.Status != PrequalificationResult.Withdrawn) NCC đạt</div>
        <form asp-action="Decide" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
            <input name="comment" class="form-control form-control-sm" placeholder="Ý kiến (bắt buộc khi trả lại)" />
            <button name="approve" value="true" class="btn btn-sm btn-success text-nowrap">Phê duyệt</button>
            <button name="approve" value="false" class="btn btn-sm btn-outline-danger text-nowrap">Trả lại</button>
        </form></div></div>
}

<div class="row g-3">
<div class="col-lg-8">
    <div class="card mb-3"><div class="card-body">
        <h5>@Model.Title</h5>
        <dl class="row small mb-0 info">
            <dt class="col-sm-3">Nhóm hàng</dt><dd class="col-sm-9">@Model.Category?.Name</dd>
            <dt class="col-sm-3">Hạn nộp hồ sơ</dt><dd class="col-sm-9 fw-semibold">@Model.Deadline.ToDateTime()@if (s == PrequalificationStatus.Open && now < Model.Deadline) { <span class="fw-normal"> · còn <span data-countdown="@((int)(Model.Deadline - now).TotalSeconds)"></span></span> }</dd>
            <dt class="col-sm-3">Đạt khi</dt><dd class="col-sm-9">Mọi tiêu chí bắt buộc đạt và điểm ≥ @Model.MinScore/100 · hiệu lực kết quả @Model.ValidityMonths tháng</dd>
            @if (!string.IsNullOrEmpty(Model.Description)) { <dt class="col-sm-3">Phạm vi</dt><dd class="col-sm-9 pre">@Model.Description</dd> }
            @if (Model.DecidedAt.HasValue) { <dt class="col-sm-3">Quyết định</dt><dd class="col-sm-9">@Model.DecidedBy?.FullName – @Model.DecidedAt.ToDateTime() @Model.DecisionNote</dd> }
        </dl>
    </div></div>
    <div class="card mb-3"><div class="card-header">Tiêu chí</div><div class="table-responsive"><table class="table table-sm mb-0">
        <thead><tr><th>#</th><th>Tiêu chí</th><th>Yêu cầu</th><th>Loại</th><th>Hồ sơ chứng minh</th></tr></thead><tbody>
        @foreach (var c in Model.Criteria) { <tr><td>@c.SortOrder</td><td>@c.Name</td><td class="small">@c.Requirement</td><td class="small">@(c.IsMandatory ? "Bắt buộc đạt" : $"Tối đa {c.MaxScore} điểm")</td><td class="small">@c.DocumentType?.GetDisplayName()</td></tr> }
    </tbody></table></div></div>

    <div class="card mb-3"><div class="card-header">Hồ sơ dự sơ tuyển (@apps.Count(a => a.Status != PrequalificationResult.Withdrawn))</div>
    <div class="table-responsive"><table class="table mb-0 align-middle">
        <thead><tr><th>Nhà cung cấp</th><th>Nộp</th><th class="money">Tài liệu</th><th class="money">Điểm</th><th>Kết quả</th><th></th></tr></thead><tbody>
        @foreach (var a in apps)
        {
            <tr class="@(a.Status == PrequalificationResult.Withdrawn ? "text-muted" : "")">
                <td><a asp-controller="Vendors" asp-action="Details" asp-route-id="@a.VendorId">@a.Vendor?.Name</a> <span class="badge bg-light text-dark border">@a.Vendor?.Status.GetDisplayName()</span>
                    @if (!string.IsNullOrEmpty(a.Note)) { <div class="small text-muted text-truncate" style="max-width:360px" title="@a.Note">@a.Note</div> }</td>
                <td class="small">@a.SubmittedAt.ToDateTime()<div class="text-muted">@(a.VendorUserId == null ? "bản giấy" : "qua cổng NCC")</div></td>
                <td class="money">@a.Documents.Count</td>
                <td class="money">@a.TotalScore?.ToString("0.##")</td>
                <td><span class="badge @(a.Status switch { PrequalificationResult.Passed => "bg-success", PrequalificationResult.Failed => "bg-danger", PrequalificationResult.Withdrawn => "bg-light text-muted border", _ => "bg-secondary" })">@a.Status.GetDisplayName()</span>
                    @if (a.ValidUntil.HasValue) { <div class="small text-muted">đến @a.ValidUntil.ToDate()</div> }</td>
                <td class="text-end">@if (buyer && s == PrequalificationStatus.Evaluating && a.Status != PrequalificationResult.Withdrawn) { <a asp-action="Evaluate" asp-route-id="@Model.Id" asp-route-applicationId="@a.Id" class="btn btn-sm btn-outline-primary">@(a.Status == PrequalificationResult.Submitted ? "Chấm hồ sơ" : "Chấm lại")</a> }</td></tr>
        }
        @if (!apps.Any()) { <tr><td colspan="6" class="text-muted p-3">Chưa có hồ sơ.</td></tr> }
    </tbody></table></div>
    @if (buyer && ViewBag.Vendors is Microsoft.AspNetCore.Mvc.Rendering.SelectList vendors && s == PrequalificationStatus.Open && now < Model.Deadline)
    {
        <div class="card-body border-top"><form asp-action="AddApplication" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
            <select name="vendorId" class="form-select form-select-sm" asp-items="vendors" required><option value="">-- Tiếp nhận hồ sơ giấy của NCC --</option></select>
            <input name="note" class="form-control form-control-sm" placeholder="Ghi chú" /><button class="btn btn-sm btn-outline-primary text-nowrap">Tiếp nhận</button></form></div>
    }
    </div>
</div>
<div class="col-lg-4"><div class="card"><div class="card-header">Nhật ký</div><div class="card-body"><partial name="_History" model="history" />@await Component.InvokeAsync("Signatures", new { type = DocType.Prequalification, id = Model.Id })</div></div></div>
</div>

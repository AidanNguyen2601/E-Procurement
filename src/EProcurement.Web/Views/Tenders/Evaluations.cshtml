@model List<Tender>
@{ ViewData["Title"] = "Đánh giá HSDT / HSCG"; var meId = User.GetUserId(); }
<div class="card"><div class="card-body p-0"><div class="table-responsive"><table class="table mb-0 align-middle">
    <thead><tr><th>@L["Gói thầu"]</th><th class="money">HSDT</th><th>@L["Hợp lệ & năng lực"]</th><th>@L["Chấm kỹ thuật"]</th><th>@L["Hồ sơ tài chính"]</th><th>@L["Việc của tôi"]</th><th></th></tr></thead>
    <tbody>
    @foreach (var t in Model)
    {
        var bids = t.Bidders.Where(b => b.Submitted).ToList();
        var screened = bids.Count(b => b.Valid.HasValue && (b.Valid == false || b.Qualified.HasValue));
        var done = t.Committee.Count(m => m.ScoringCompletedAt.HasValue);
        var me = t.Committee.FirstOrDefault(m => m.UserId == meId);
        var task = t.Status == TenderStatus.Published ? (User.IsPurchasing() ? "Đã đóng thầu – mở thầu" : "")
            : me == null ? "" : me.ConflictDeclaredAt == null ? "Cam kết không xung đột lợi ích" : me.ScoringCompletedAt == null ? "Chấm điểm kỹ thuật" : "Đã nộp phiếu chấm";
        <tr><td><a asp-action="Details" asp-route-id="@t.Id" class="fw-semibold">@t.Number</a><div class="small">@t.Title</div>
                <div class="small text-muted">@t.EnvelopeMethod.GetDisplayName() @L["· đóng thầu"] @t.ClosingAt.ToDateTime()</div></td>
            <td class="money">@bids.Count</td>
            <td class="small">@(t.OpenedAt == null ? L["Chưa mở thầu"] : $"{screened}/{bids.Count}")</td>
            <td class="small">@(t.OpenedAt == null ? "" : L["{0}/{1} thành viên", done, t.Committee.Count])</td>
            <td class="small">@(t.EnvelopeMethod == EnvelopeMethod.OneEnvelope ? L["Một túi"] : t.FinancialOpenedAt.HasValue ? L["Đã mở {0:dd/MM}", t.FinancialOpenedAt] : L["Niêm phong"])</td>
            <td class="small">@if (!string.IsNullOrEmpty(task)) { <span class="badge @(task.StartsWith("Đã") ? "bg-light text-dark border" : "bg-warning text-dark")">@task</span> }</td>
            <td class="text-end text-nowrap">
                @if (t.Status == TenderStatus.Opened && (User.IsPurchasing() || me?.IsLeader == true)) { <a asp-action="Screen" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">@L["Đánh giá hợp lệ"]</a> }
                @if (t.Status == TenderStatus.Opened && me != null) { <a asp-action="Score" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">@L["Chấm điểm"]</a> }
                <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary">@L["Chi tiết"]</a></td></tr>
    }
    @if (!Model.Any()) { <tr><td colspan="7" class="text-muted p-3">@L["Không có gói thầu đang đánh giá."]</td></tr> }
    </tbody>
</table></div></div></div>

@model List<Tender>
@{
    ViewData["Title"] = "Đấu thầu rộng rãi";
    var status = ViewBag.Status as TenderStatus?;
    var items = Html.GetEnumSelectList<TenderStatus>().ToList();
    foreach (var i in items) i.Selected = status.HasValue && i.Value == ((int)status.Value).ToString();
}
<form method="get" class="toolbar">
    <select name="status" class="form-select form-select-sm" style="width:auto" asp-items="items" onchange="this.form.submit()"><option value="">-- Mọi trạng thái --</option></select>
    <a asp-action="Public" target="_blank" class="btn btn-sm btn-outline-secondary ms-auto">Trang thông báo mời thầu công khai ↗</a>
</form>
<div class="card"><div class="card-body p-0"><table class="table mb-0">
    <thead><tr><th>Số</th><th>Gói thầu</th><th>Đề nghị</th><th class="money">Giá gói thầu</th><th>Đóng thầu</th><th class="money">Nhà thầu</th><th>Trúng thầu</th><th>Trạng thái</th></tr></thead>
    <tbody>
    @foreach (var t in Model)
    {
        <tr>
            <td><a asp-action="Details" asp-route-id="@t.Id" class="fw-semibold">@t.Number</a></td>
            <td>@t.Title<br /><small class="text-muted">@t.EnvelopeMethod.GetDisplayName()</small></td>
            <td>@t.PurchaseRequest?.Number</td>
            <td class="money">@t.PackageBudget.ToMoney()</td>
            <td class="@(t.Status == TenderStatus.Published && t.ClosingAt < DateTime.Now ? "text-danger" : "")">@t.ClosingAt.ToDateTime()</td>
            <td class="money">@t.Bidders.Count(b => b.Submitted)/@t.Bidders.Count</td>
            <td>@(t.Status >= TenderStatus.Awarded && t.Status != TenderStatus.Cancelled ? t.AwardedVendor?.Name : "")</td>
            <td><partial name="_Badge" model="t.Status" /></td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="8" class="text-muted p-3">Chưa có gói thầu nào. Lập gói thầu từ đề nghị mua hàng đã duyệt (hình thức Đấu thầu rộng rãi).</td></tr> }
    </tbody>
</table></div></div>

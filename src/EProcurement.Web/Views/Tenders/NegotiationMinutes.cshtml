@model Tender
@{
    var n = (TenderNegotiation)ViewBag.Negotiation;
    var b = Model.Bidders.First(x => x.Id == n.TenderBidderId);
    ViewData["Title"] = $"Biên bản đàm phán – {Model.Number}";
}
<div class="toolbar no-print"><button class="btn btn-outline-secondary" onclick="window.print()">In / Lưu PDF</button></div>
<div class="card paper mb-4"><div class="card-body p-4">
    <div class="text-center mb-3"><h4 class="mb-0">BIÊN BẢN ĐÀM PHÁN HỢP ĐỒNG</h4>
        <div>Gói thầu: @Model.Title (@Model.Number)</div>
        <div class="text-muted">Ngày @n.NegotiatedOn.ToDate()</div></div>
    <p><b>Thành phần tham dự:</b> @n.Participants</p>
    <p><b>Nhà thầu:</b> @b.Vendor?.Name – MST @b.Vendor?.TaxCode · xếp hạng thứ @n.Rank theo kết quả đánh giá HSDT.</p>
    <p class="mb-1"><b>Nội dung đàm phán:</b></p>
    <div class="pre mb-3">@n.Content</div>
    <table class="table table-bordered table-sm">
        <tr><th style="width:50%">Giá dự thầu sau giảm giá (trước VAT)</th><td class="money">@n.BidPrice.ToMoney() đ</td></tr>
        @if (n.Success)
        {
            <tr><th>Giá sau đàm phán (trước VAT)</th><td class="money fw-bold">@n.NegotiatedPrice.ToMoney() đ</td></tr>
            <tr><th>Giảm so với giá dự thầu</th><td class="money">@((n.BidPrice - n.NegotiatedPrice).ToMoney()) đ</td></tr>
        }
    </table>
    <p><b>Kết luận:</b> @(n.Success ? "Đàm phán hợp đồng thành công. Bên mời thầu trình phê duyệt kết quả lựa chọn nhà thầu theo giá sau đàm phán." : "Đàm phán hợp đồng không thành công.")
        @if (!string.IsNullOrEmpty(n.Note)) { <span>@n.Note</span> }
        @if (n.IsVoid) { <span class="text-danger">(Biên bản đã hết hiệu lực do kết quả bị trả lại / kiến nghị được chấp nhận.)</span> }</p>
    <div class="row text-center mt-4 small">
        <div class="col">ĐẠI DIỆN BÊN MỜI THẦU<br /><br /><br /><br />@Model.Buyer?.FullName</div>
        <div class="col">ĐẠI DIỆN NHÀ THẦU<br /><br /><br /><br />@b.Vendor?.ContactPerson</div>
    </div>
</div></div>

@model Tuple<Tender, BoqActualsResult>
@using EProcurement.Web.Infrastructure
@{
    var t = Model.Item1; var r = Model.Item2; var c = ViewBag.Contract as Contract;
    ViewData["Title"] = $"{L["Dự toán – thực tế"]} {t.Number}";
    var hasContract = c != null; var hasEst = r.EstTotal > 0;
    string Cls(decimal v) => v > 0 ? "text-danger" : v < 0 ? "text-success" : "";
    string Sg(decimal v) => v > 0 ? "+" : "";
    var award = r.AwardPrice;
    var awardVsEst = award - r.EstTotal; var awardPct = r.EstTotal > 0 ? Math.Round(awardVsEst * 100 / r.EstTotal, 1) : 0;
    var contractVsEst = r.ContractCurrent - r.EstTotal; var contractPct = r.EstTotal > 0 ? Math.Round(contractVsEst * 100 / r.EstTotal, 1) : 0;
    var done = r.ContractCurrent > 0 ? Math.Min(100, r.ActualTotal * 100 / r.ContractCurrent) : 0;
    var actVsEst = r.ActualTotal - r.EstForActualTotal;
    var gross = c == null ? 0 : Math.Round(c.Value * (1 + c.VatPercent / 100m), 0);
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<style>
    .act-table td, .act-table th { white-space: nowrap; }
    .act-table tr.grp > td { background: #f1f5f9; font-weight: 600; }
    .act-table .bh { border-left: 2px solid #cbd5e1; }
</style>
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-outline-secondary btn-sm">← @t.Number</a>
    <h5 class="mb-0">@L["Giá dự toán – giá trúng thầu – giá thực tế"] – @t.Title</h5>
    <span class="ms-auto d-flex gap-1">
        <a asp-action="ActualsSummary" class="btn btn-outline-secondary btn-sm">@L["Tổng hợp các gói thầu"]</a>
        <a asp-action="Actuals" asp-route-id="@t.Id" asp-route-csv="true" class="btn btn-outline-success btn-sm">@L["Xuất CSV"]</a>
    </span>
</div>
@if (!hasContract) { <div class="alert alert-info small py-2">@(award > 0 ? L["Gói thầu chưa ký hợp đồng – hiện chỉ có dự toán và giá trúng thầu."] : L["Gói thầu chưa ký hợp đồng – hiện chỉ có dự toán."])</div> }

<div class="row g-3 mb-3">
    <div class="col-md"><div class="card h-100"><div class="card-body py-2">
        <div class="small text-muted">@L["Giá dự toán (tổng các dòng, trước VAT)"]</div><div class="fs-5 fw-semibold">@r.EstTotal.ToMoney() đ</div>
        <div class="small text-muted">@L["Giá gói"] @r.PackageBudget.ToMoney() đ</div>
    </div></div></div>
    <div class="col-md"><div class="card h-100"><div class="card-body py-2">
        <div class="small text-muted">@L["Giá trúng thầu (trước VAT)"]</div><div class="fs-5 fw-semibold">@(award > 0 ? award.ToMoney() + " đ" : "—")</div>
        @if (award > 0 && hasEst) { <div class="small @Cls(awardVsEst)">@Sg(awardVsEst)@awardVsEst.ToMoney() đ (@Sg(awardPct)@awardPct.ToString("0.#", I18n.ViCulture)%) @L["so với dự toán"]</div> }
        @if (t.AwardedVendor != null) { <div class="small text-muted">@t.AwardedVendor.Name</div> }
    </div></div></div>
    @if (hasContract)
    {
    <div class="col-md"><div class="card h-100"><div class="card-body py-2">
        <div class="small text-muted">@L["Giá hợp đồng hiện hành (trước VAT)"]</div><div class="fs-5 fw-semibold">@r.ContractCurrent.ToMoney() đ</div>
        @if (hasEst) { <div class="small @Cls(contractVsEst)">@Sg(contractVsEst)@contractVsEst.ToMoney() đ (@Sg(contractPct)@contractPct.ToString("0.#", I18n.ViCulture)%) @L["so với dự toán"]</div> }
        @if (r.ContractCurrent != r.ContractOriginal) { <div class="small text-muted">@L["Ban đầu"] @r.ContractOriginal.ToMoney() đ · @L["phụ lục"] @Sg(r.ContractCurrent - r.ContractOriginal)@((r.ContractCurrent - r.ContractOriginal).ToMoney()) đ</div> }
        <div class="small"><a asp-controller="Contracts" asp-action="Details" asp-route-id="@c!.Id">@c.Number</a></div>
    </div></div></div>
    @if (c!.IsFramework || r.OrderedTotal > 0)
    {
    <div class="col-md"><div class="card h-100"><div class="card-body py-2">
        <div class="small text-muted">@L["Đã đặt hàng theo hợp đồng (trước VAT)"]@if (c.IsFramework) { <span class="badge text-bg-secondary ms-1">@L["hợp đồng khung"]</span> }</div>
        <div class="fs-5 fw-semibold">@r.OrderedTotal.ToMoney() đ</div>
        <div class="progress my-1" style="height:6px"><div class="progress-bar bg-primary" style="width:@(r.ContractCurrent > 0 ? Math.Min(100, r.OrderedTotal * 100 / r.ContractCurrent) : 0).ToString("0.#", inv)%"></div></div>
        <div class="small text-muted">@(r.ContractCurrent > 0 ? Math.Round(r.OrderedTotal * 100 / r.ContractCurrent, 1) : 0)% @L["giá trị hợp đồng"] · @L["còn lại"] @Math.Max(0, r.ContractCurrent - r.OrderedTotal).ToMoney() đ</div>
    </div></div></div>
    }
    <div class="col-md"><div class="card h-100"><div class="card-body py-2">
        <div class="small text-muted">@L["Giá thực tế đã thực hiện"]</div><div class="fs-5 fw-semibold">@r.ActualTotal.ToMoney() đ</div>
        <div class="progress my-1" style="height:6px"><div class="progress-bar bg-success" style="width:@done.ToString("0.#", inv)%"></div></div>
        <div class="small text-muted">@done.ToString("0.#", I18n.ViCulture)% @L["giá trị hợp đồng"]@if (hasEst && r.EstForActualTotal > 0) { <span class="@Cls(actVsEst)"> · @Sg(actVsEst)@actVsEst.ToMoney() đ @L["so với dự toán phần đã làm"]</span> }</div>
    </div></div></div>
    <div class="col-md"><div class="card h-100"><div class="card-body py-2">
        <div class="small text-muted">@L["Thực chi (đã trừ tạm ứng)"]</div><div class="fs-5 fw-semibold">@r.PaidNet.ToMoney() đ</div>
        <div class="small text-muted">@L["chờ chi"] @r.RequestedGross.ToMoney() đ · @L["giá trị HĐ gồm VAT"] @gross.ToMoney() đ</div>
    </div></div></div>
    }
</div>
@if (hasContract) { <div class="small text-muted mb-2">@L["Thực tế = khối lượng đã thực hiện × đơn giá hợp đồng: nghiệm thu khối lượng (hợp đồng theo BOQ) hoặc hàng đã nhận đạt trên phiếu nhận hàng. Dự toán phần đã làm = cùng khối lượng × đơn giá dự toán."]</div> }

<div class="card"><div class="table-responsive">
<table class="table table-sm table-bordered mb-0 small align-middle act-table" data-grid="off">
    <thead>
        <tr><th rowspan="2">@L["Mã"]</th><th rowspan="2">@L["Hạng mục / công việc"]</th><th rowspan="2">@L["ĐVT"]</th><th colspan="3" class="text-center bh">@L["Dự toán"]</th>@if (hasContract) { <th colspan="4" class="text-center bh">@L["Hợp đồng"]</th><th colspan="3" class="text-center bh">@L["Thực tế"]</th> }</tr>
        <tr><th class="text-end bh">@L["KL"]</th><th class="text-end">@L["Đơn giá"]</th><th class="text-end">@L["Thành tiền"]</th>
            @if (hasContract) { <th class="text-end bh">@L["KL"]</th><th class="text-end">@L["Đơn giá"]</th><th class="text-end">@L["Thành tiền"]</th><th class="text-end">@L["± dự toán"]</th>
            <th class="text-end bh">@L["KL đã làm"]</th><th class="text-end">@L["Thành tiền"]</th><th class="text-end">@L["± dự toán phần đã làm"]</th> }</tr>
    </thead>
    <tbody>
    @foreach (var x in r.Rows)
    {
        <tr class="@(x.IsGroup ? "grp" : "")">
            <td>@x.Code</td>
            <td style="padding-left:@(8 + x.Depth * 16)px">@x.Name@if (x.Added) { <span class="badge text-bg-info ms-1">@L["phát sinh"]</span> }</td>
            <td>@(x.IsGroup ? "" : x.Unit)</td>
            <td class="text-end bh">@(x.IsGroup ? "" : x.EstQuantity.ToQty())</td><td class="text-end">@(x.IsGroup ? "" : x.EstUnitPrice.ToMoney())</td><td class="text-end">@x.EstAmount.ToMoney()</td>
            @if (hasContract)
            {
                <td class="text-end bh">@(x.IsGroup ? "" : x.ContractQuantity.ToQty())</td><td class="text-end">@(x.IsGroup ? "" : x.ContractUnitPrice.ToMoney())</td><td class="text-end">@x.ContractAmount.ToMoney()</td>
                <td class="text-end @Cls(x.ContractVsEstimate)">@if (hasEst && (!x.Added || x.IsGroup)) { <span>@Sg(x.ContractVsEstimate)@x.ContractVsEstimate.ToMoney()@if (x.ContractVsEstimatePct != null) { <span class="text-muted"> (@Sg(x.ContractVsEstimatePct.Value)@x.ContractVsEstimatePct.Value.ToString("0.#", I18n.ViCulture)%)</span> }</span> }</td>
                <td class="text-end bh">@(x.IsGroup ? "" : x.ActualQuantity.ToQty())</td><td class="text-end">@x.ActualAmount.ToMoney()@if (x.ContractAmount > 0) { <span class="text-muted"> (@x.Progress.ToString("0.#", I18n.ViCulture)%)</span> }</td>
                <td class="text-end @Cls(x.ActualVsEstimate)">@if (hasEst && x.ActualAmount > 0 && x.EstForActual > 0) { <span>@Sg(x.ActualVsEstimate)@x.ActualVsEstimate.ToMoney()</span> }</td>
            }
        </tr>
    }
    </tbody>
    <tfoot><tr class="fw-semibold"><td colspan="5" class="text-end">@L["Tổng cộng (trước VAT)"]</td><td class="text-end">@r.EstTotal.ToMoney()</td>
        @if (hasContract) { <td colspan="2" class="bh"></td><td class="text-end">@r.ContractCurrent.ToMoney()</td><td class="text-end @Cls(contractVsEst)">@(hasEst ? Sg(contractVsEst) + contractVsEst.ToMoney() : "")</td><td class="bh"></td><td class="text-end">@r.ActualTotal.ToMoney()</td><td class="text-end @Cls(actVsEst)">@(hasEst ? Sg(actVsEst) + actVsEst.ToMoney() : "")</td> }</tr></tfoot>
</table></div></div>

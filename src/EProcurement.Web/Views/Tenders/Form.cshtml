@model TenderFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Lập gói thầu – kế hoạch & HSMT" : $"Sửa gói thầu {Model.Number}";
    var pr = Model.PurchaseRequest;
}
<form asp-action="Save" method="post">
    <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="PurchaseRequestId" />
    <div asp-validation-summary="All" class="text-danger"></div>
    @if (pr != null)
    {
        <div class="alert alert-info py-2">Từ đề nghị <b>@pr.Number</b> – @pr.Title (dự toán @pr.EstimatedTotal.ToMoney() đ).
            Hạng mục mời thầu lấy theo đề nghị: @string.Join("; ", pr.Lines.OrderBy(l => l.SortOrder).Select(l => $"{l.Description} × {l.Quantity.ToQty()} {l.Unit}")).</div>
    }

    <div class="card mb-3"><div class="card-header">1. Kế hoạch lựa chọn nhà thầu</div><div class="card-body row g-3">
        <div class="col-md-2"><label asp-for="Number" class="form-label"></label><input asp-for="Number" class="form-control" readonly /></div>
        <div class="col-md-6"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="PackageBudget" class="form-label"></label><input asp-for="PackageBudget" type="number" step="1000" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="EnvelopeMethod" class="form-label"></label><select asp-for="EnvelopeMethod" class="form-select" asp-items="Html.GetEnumSelectList<EnvelopeMethod>()"></select></div>
        <div class="col-md-2"><label asp-for="ContractType" class="form-label"></label><select asp-for="ContractType" class="form-select" asp-items="@(await Catalog.SelectAsync(CatalogType.ContractType, Model.ContractType))"></select></div>
        <div class="col-md-2"><label asp-for="ContractDurationDays" class="form-label"></label><input asp-for="ContractDurationDays" class="form-control" /></div>
        <div class="col-md-2 d-flex align-items-end"><div class="form-check"><input asp-for="IsFramework" class="form-check-input" /><label asp-for="IsFramework" class="form-check-label"></label></div></div>
        <div class="col-md-4"><label asp-for="ClosingAt" class="form-label"></label><input asp-for="ClosingAt" type="datetime-local" class="form-control" />
            <div class="small text-muted">Tối thiểu @(((ProcurementSettings?)ViewBag.Settings)?.TenderMinBiddingDays.ToString() ?? "N") ngày sau khi phát hành HSMT.</div></div>
    </div></div>

    <div class="card mb-3"><div class="card-header">2. Hồ sơ mời thầu</div><div class="card-body row g-3">
        <div class="col-12"><label asp-for="TechnicalRequirements" class="form-label"></label><textarea asp-for="TechnicalRequirements" class="form-control" rows="4"></textarea></div>
        <div class="col-12"><label asp-for="QualificationCriteria" class="form-label"></label>
            <textarea asp-for="QualificationCriteria" class="form-control" rows="3" placeholder="VD: Đã thực hiện ≥ 2 hợp đồng tương tự trong 3 năm; doanh thu bình quân ≥ …; là đại lý ủy quyền của hãng…"></textarea></div>
        <div class="col-12"><label asp-for="ContractTerms" class="form-label"></label><textarea asp-for="ContractTerms" class="form-control" rows="2"></textarea></div>
        <div class="col-md-6"><label asp-for="EvaluationMethod" class="form-label"></label>
            <select asp-for="EvaluationMethod" class="form-select" asp-items="Html.GetEnumSelectList<TenderEvaluationMethod>()" id="evalMethod"></select></div>
        <div class="col-md-2"><label asp-for="MinTechnicalScore" class="form-label"></label><input asp-for="MinTechnicalScore" class="form-control" /></div>
        <div class="col-md-2 weights"><label asp-for="TechnicalWeight" class="form-label"></label><input asp-for="TechnicalWeight" class="form-control" /></div>
        <div class="col-md-2 weights"><label asp-for="PriceWeight" class="form-label"></label><input asp-for="PriceWeight" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="BidSecurityAmount" class="form-label"></label><input asp-for="BidSecurityAmount" type="number" step="1000" class="form-control" />
            <div class="small text-muted">Thường 1–3% giá gói thầu.</div></div>
        <div class="col-md-4"><label asp-for="BidValidityDays" class="form-label"></label><input asp-for="BidValidityDays" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="PerformanceSecurityPercent" class="form-label"></label><input asp-for="PerformanceSecurityPercent" type="number" step="0.5" class="form-control" /></div>
    </div></div>

    <button class="btn btn-primary">Lưu</button>
    <a asp-controller="PurchaseRequests" asp-action="Details" asp-route-id="@Model.PurchaseRequestId" class="btn btn-light">Hủy</a>
</form>
@section Scripts {
<script>
    (function () {
        const sel = document.getElementById('evalMethod');
        const toggle = () => document.querySelectorAll('.weights').forEach(e => e.style.display = sel.value === '2' ? '' : 'none');
        sel.addEventListener('change', toggle); toggle();
    })();
</script>
}

@model TenderFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Lập gói thầu – kế hoạch & HSMT" : $"Sửa gói thầu {Model.Number}";
    var pr = Model.PurchaseRequest;
}
<form asp-action="Save" method="post">
    <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="PurchaseRequestId" /><input type="hidden" asp-for="PackageId" />
    <partial name="_PackageBanner" model="ViewBag.Package as ProcurementPackage" />
    <div asp-validation-summary="All" class="text-danger"></div>
    @if (ViewBag.Package is ProcurementPackage pk)
    {
        <div class="alert alert-light border py-2 small">Hạng mục mời thầu lấy theo gói: @string.Join("; ", EProcurement.Web.Infrastructure.Packages.Lines(pk).Select(l => $"{l.Description} × {l.Quantity.ToQty()} {l.Unit}")).</div>
    }
    else if (pr != null)
    {
        <div class="alert alert-info py-2">@L["Từ đề nghị"] <b>@pr.Number</b> – @pr.Title (dự toán @pr.EstimatedTotal.ToMoney() đ).
            Hạng mục mời thầu lấy theo đề nghị: @string.Join("; ", pr.Lines.OrderBy(l => l.SortOrder).Select(l => $"{l.Description} × {l.Quantity.ToQty()} {l.Unit}")).</div>
    }

    <div class="card mb-3"><div class="card-header">@L["1. Kế hoạch lựa chọn nhà thầu (theo KHLCNT đã duyệt) & HSMT"]</div><div class="card-body row g-3">
        <div class="col-md-2"><label asp-for="Number" class="form-label"></label><input asp-for="Number" class="form-control" readonly /></div>
        <div class="col-md-6"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="PackageBudget" class="form-label"></label><input asp-for="PackageBudget" type="number" step="1000" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="EnvelopeMethod" class="form-label"></label><select asp-for="EnvelopeMethod" class="form-select" asp-items="Html.GetEnumSelectList<EnvelopeMethod>()"></select></div>
        <div class="col-md-2"><label asp-for="ContractType" class="form-label"></label><select asp-for="ContractType" class="form-select" asp-items="@(await Catalog.SelectAsync(CatalogType.ContractType, Model.ContractType))"></select></div>
        <div class="col-md-2"><label asp-for="ContractDurationDays" class="form-label"></label><input asp-for="ContractDurationDays" class="form-control" /></div>
        <div class="col-md-2 d-flex align-items-end flex-column align-items-start justify-content-end"><div class="form-check"><input asp-for="IsFramework" class="form-check-input" /><label asp-for="IsFramework" class="form-check-label"></label></div>
            <div class="form-check"><input asp-for="IsInternational" class="form-check-input" /><label asp-for="IsInternational" class="form-check-label"></label></div></div>
        <div class="col-md-2 d-flex align-items-end"><div class="form-check"><input asp-for="AllowJointVenture" class="form-check-input" /><label asp-for="AllowJointVenture" class="form-check-label"></label></div></div>
        <div class="col-md-2"><label asp-for="MaxSubcontractPercent" class="form-label"></label><input asp-for="MaxSubcontractPercent" type="number" min="0" max="100" step="0.5" class="form-control" placeholder="@L["Không giới hạn"]" /></div>
        <div class="col-md-2"><label asp-for="DomesticPreferencePercent" class="form-label"></label><input asp-for="DomesticPreferencePercent" type="number" min="0" max="50" step="0.1" class="form-control" title="@L["Cộng thêm vào giá xếp hạng của nhà thầu không thuộc đối tượng ưu đãi – theo tỷ lệ quy định hiện hành"]" /></div>
        <div class="col-md-4"><label asp-for="ClosingAt" class="form-label"></label><input asp-for="ClosingAt" type="datetime-local" class="form-control" />
            @if (ViewBag.LegalMin is LegalMin lm) { <div class="small text-muted">@L["Tối thiểu"] @lm.Text @L["từ ngày phát hành HSMT"] (@lm.Basis). @L["Đấu thầu quốc tế / gói vượt ngưỡng quy mô nhỏ có thời gian dài hơn – hệ thống kiểm tra khi trình duyệt."]</div> }</div>
    </div></div>

    <div class="card mb-3"><div class="card-header">@L["2. Hồ sơ mời thầu"]</div><div class="card-body row g-3">
        <div class="col-12"><div class="d-flex flex-wrap gap-2 align-items-center mb-1"><label asp-for="TechnicalRequirements" class="form-label mb-0"></label><span class="ms-auto">@await Html.PartialAsync("_CriteriaPicker", ("TenderTechnical", "text", "#TechnicalRequirements"))</span></div><textarea asp-for="TechnicalRequirements" class="form-control" rows="4"></textarea></div>
        <div class="col-12"><div class="d-flex flex-wrap gap-2 align-items-center mb-1"><label asp-for="QualificationCriteria" class="form-label mb-0"></label><span class="ms-auto">@await Html.PartialAsync("_CriteriaPicker", ("TenderQualification", "text", "#QualificationCriteria"))</span></div>
            <textarea asp-for="QualificationCriteria" class="form-control" rows="3" placeholder="@L["VD: Đã thực hiện ≥ 2 hợp đồng tương tự trong 3 năm; doanh thu bình quân ≥ …; là đại lý ủy quyền của hãng…"]"></textarea></div>
        <div class="col-12"><label asp-for="ContractTerms" class="form-label"></label><textarea asp-for="ContractTerms" class="form-control" rows="2"></textarea></div>
        <div class="col-md-6"><label asp-for="EvaluationMethod" class="form-label"></label>
            <select asp-for="EvaluationMethod" class="form-select" asp-items="Html.GetEnumSelectList<TenderEvaluationMethod>()" id="evalMethod"></select></div>
        <div class="col-md-2"><label asp-for="MinTechnicalScore" class="form-label"></label><input asp-for="MinTechnicalScore" class="form-control" /></div>
        <div class="col-md-2 weights"><label asp-for="TechnicalWeight" class="form-label"></label><input asp-for="TechnicalWeight" class="form-control" /></div>
        <div class="col-md-2 weights"><label asp-for="PriceWeight" class="form-label"></label><input asp-for="PriceWeight" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="BidSecurityAmount" class="form-label"></label><input asp-for="BidSecurityAmount" type="number" step="1000" class="form-control" />
            <div class="small text-muted">@L["Thường 1–3% giá gói thầu."]</div></div>
        <div class="col-md-4"><label asp-for="BidValidityDays" class="form-label"></label><input asp-for="BidValidityDays" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="PerformanceSecurityPercent" class="form-label"></label><input asp-for="PerformanceSecurityPercent" type="number" step="0.5" class="form-control" /></div>
    </div></div>

    <button class="btn btn-primary">@L["Lưu"]</button>
    <a asp-controller="PurchaseRequests" asp-action="Details" asp-route-id="@Model.PurchaseRequestId" class="btn btn-light">@L["Hủy"]</a>
</form>
@section Scripts {
<script>
    (function () {
        const sel = document.getElementById('evalMethod');
        const toggle = () => document.querySelectorAll('.weights').forEach(e => e.style.display = sel.value === '2' ? '' : 'none');
        sel.addEventListener('change', toggle); toggle();
    })();
</script>
}

@model List<Tender>
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Danh sách gói thầu";
}
<div class="card"><div class="card-body p-0"><table class="table mb-0">
    <thead><tr><th>Số</th><th>Gói thầu</th><th>Phát hành</th><th>Đóng thầu</th><th>Tình trạng</th></tr></thead>
    <tbody>
    @foreach (var t in Model)
    {
        var open = t.Status == TenderStatus.Published && t.ClosingAt > DateTime.Now;
        <tr>
            <td><a asp-action="Notice" asp-route-id="@t.Id" class="fw-semibold">@t.Number</a></td>
            <td>@t.Title</td>
            <td>@t.PublishedAt.ToDate()</td>
            <td>@t.ClosingAt.ToDateTime()</td>
            <td>@if (open) { <span class="badge bg-success">Đang nhận HSDT</span> }
                else if (t.Status is TenderStatus.Awarded or TenderStatus.Contracted) { <span class="badge bg-primary">Đã có kết quả</span> }
                else { <span class="badge bg-secondary">Đã đóng thầu</span> }</td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="5" class="text-muted p-3">Hiện không có gói thầu nào.</td></tr> }
    </tbody>
</table></div></div>

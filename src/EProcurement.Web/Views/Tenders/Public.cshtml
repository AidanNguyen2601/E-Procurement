@model List<Tender>
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Danh sách gói thầu";
}
<div class="card"><div class="card-body p-0"><table class="table mb-0">
    <thead><tr><th>@L["Số"]</th><th>@L["Gói thầu"]</th><th>@L["Phát hành"]</th><th>@L["Đóng thầu"]</th><th>@L["Tình trạng"]</th></tr></thead>
    <tbody>
    @foreach (var t in Model)
    {
        var open = t.Status == TenderStatus.Published && t.ClosingAt > DateTime.Now;
        <tr>
            <td><a asp-action="Notice" asp-route-id="@t.Id" class="fw-semibold">@t.Number</a></td>
            <td>@t.Title</td>
            <td>@t.PublishedAt.ToDate()</td>
            <td>@t.ClosingAt.ToDateTime()</td>
            <td>@if (open) { <span class="badge bg-success">@L["Đang nhận HSDT"]</span> }
                else if (t.Status is TenderStatus.Awarded or TenderStatus.Contracted) { <span class="badge bg-primary">@L["Đã có kết quả"]</span> }
                else { <span class="badge bg-secondary">@L["Đã đóng thầu"]</span> }</td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="5" class="text-muted p-3">@L["Hiện không có gói thầu nào."]</td></tr> }
    </tbody>
</table></div></div>

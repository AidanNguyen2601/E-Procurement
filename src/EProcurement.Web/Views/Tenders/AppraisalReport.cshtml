@model Tender
@{
    var a = (TenderAppraisal)ViewBag.Appraisal;
    var results = (List<BidResult>)ViewBag.Results;
    var neg = TenderEvaluation.SuccessfulNegotiation(Model.Negotiations) ?? Model.Negotiations.Where(n => n.Success).OrderByDescending(n => n.CreatedAt).FirstOrDefault();
    ViewData["Title"] = $"Báo cáo thẩm định – {Model.Number}";
}
<div class="toolbar no-print"><button class="btn btn-outline-secondary" onclick="window.print()">@L["In / Lưu PDF"]</button></div>
<div class="card paper mb-4"><div class="card-body p-4">
    <div class="text-center mb-3"><h4 class="mb-0">@L["BÁO CÁO THẨM ĐỊNH KẾT QUẢ LỰA CHỌN NHÀ THẦU"]</h4>
        <div>@L["Gói thầu:"] @Model.Title (@Model.Number)</div>
        <div class="text-muted">@L["Ngày"] @a.CompletedAt?.ToDate()</div></div>
    <p class="mb-1"><b>@L["I. Thông tin gói thầu"]</b></p>
    <ul class="small">
        <li>@L["Giá gói thầu:"] @Model.PackageBudget.ToMoney() @L["đ (trước VAT) ·"] @Model.EnvelopeMethod.GetDisplayName() · @Model.EvaluationMethod.GetDisplayName()</li>
        <li>@L["Phát hành HSMT"] @Model.PublishedAt.ToDateTime() @L["· đóng thầu"] @Model.ClosingAt.ToDateTime() @L["· mở thầu"] @Model.OpenedAt.ToDateTime()</li>
        <li>Số nhà thầu nộp HSDT: @Model.Bidders.Count(b => b.Submitted) · tổ chuyên gia @Model.Committee.Count thành viên</li>
    </ul>
    <p class="mb-1"><b>@L["II. Kết quả đánh giá và đề xuất của bên mời thầu"]</b></p>
    <table class="table table-bordered table-sm small">
        <thead><tr><th>@L["Nhà thầu"]</th><th class="money">@L["Điểm KT"]</th><th class="money">@L["Giá đánh giá (gồm VAT)"]</th><th>@L["Xếp hạng"]</th><th>@L["Ghi chú"]</th></tr></thead>
        <tbody>@foreach (var r in results) { <tr><td>@r.Bid.Vendor?.Name</td><td class="money">@r.TechnicalAverage?.ToString("0.##")</td><td class="money">@(r.TechnicalPass ? r.Bid.EvaluatedPrice.ToMoney() : "")</td><td>@r.Rank</td><td>@string.Join("; ", r.Issues)</td></tr> }</tbody>
    </table>
    <p class="small">@L["Đề nghị trúng thầu:"] <b>@Model.AwardedVendor?.Name</b> @L["– giá"] @Model.AwardPrice?.ToMoney() @L["đ (trước VAT)"]@(neg != null ? L[", theo đàm phán hợp đồng ngày {0:dd/MM/yyyy} (giá dự thầu {1} đ)", neg.NegotiatedOn, neg.BidPrice.ToMoney()] : "").
        @Model.AwardReason</p>
    <p class="mb-1"><b>@L["III. Nội dung thẩm định"]</b></p>
    <div class="pre mb-3">@a.Content</div>
    <p class="mb-1"><b>@L["IV. Kết luận"]</b></p>
    <p>@(a.Agree == true ? L["Thống nhất với đề xuất kết quả lựa chọn nhà thầu của bên mời thầu, đề nghị Giám đốc phê duyệt."] : L["Không thống nhất với đề xuất kết quả lựa chọn nhà thầu của bên mời thầu."])</p>
    @if (!string.IsNullOrEmpty(a.Recommendation)) { <p class="mb-1"><b>@L["Kiến nghị:"]</b></p><div class="pre mb-3">@a.Recommendation</div> }
    @if (a.IsVoid) { <p class="text-danger small">@L["(Báo cáo đã hết hiệu lực do kết quả bị trả lại / kiến nghị được chấp nhận.)"]</p> }
    <div class="row text-center mt-4 small">
        <div class="col"></div>
        <div class="col">@L["NGƯỜI THẨM ĐỊNH"]<br />@L["(đã ký điện tử"] @a.CompletedAt.ToDateTime())<br /><br /><br />@a.Appraiser?.FullName</div>
    </div>
</div></div>

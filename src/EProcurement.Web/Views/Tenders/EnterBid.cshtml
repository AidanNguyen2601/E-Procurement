@model BidEntryViewModel
@{
    var b = Model.Bidder!;
    var t = b.Tender!;
    ViewData["Title"] = $"Tiếp nhận HSDT – {b.Vendor?.Name}";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<div class="alert alert-info py-2 small">@t.Number – @t.Title@L[". Đóng thầu"] <b>@t.ClosingAt.ToDateTime()</b>@L["; HSDT nộp sau thời điểm này bị từ chối. Yêu cầu bảo đảm dự thầu"] <b>@t.BidSecurityAmount.ToMoney() đ</b>@L[", hiệu lực đến ít nhất"] @t.ClosingAt.Date.AddDays(t.BidValidityDays + 30).ToDate()@L["; hiệu lực HSDT ≥"] @t.BidValidityDays @L["ngày. Thời điểm tiếp nhận được hệ thống ghi tự động."]</div>
<form asp-action="EnterBid" method="post">
    <input type="hidden" asp-for="TenderBidderId" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="card mb-3"><div class="card-body row g-3">
        <div class="col-md-2"><label asp-for="DiscountPercent" class="form-label"></label><input asp-for="DiscountPercent" type="number" step="0.1" class="form-control" id="disc" /></div>
        <div class="col-md-2"><label asp-for="VatPercent" class="form-label"></label><select asp-for="VatPercent" class="form-select" id="vat"><option value="0">0%</option><option value="5">5%</option><option value="8">8%</option><option value="10">10%</option></select></div>
        <div class="col-md-2"><label asp-for="LeadTimeDays" class="form-label"></label><input asp-for="LeadTimeDays" class="form-control" /></div>
        <div class="col-md-2"><label asp-for="ValidityDays" class="form-label"></label><input asp-for="ValidityDays" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Note" class="form-label"></label><input asp-for="Note" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="BidSecurityAmount" class="form-label"></label><input asp-for="BidSecurityAmount" type="number" step="1000" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="BidSecurityRef" class="form-label"></label><input asp-for="BidSecurityRef" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="BidSecurityExpiry" class="form-label"></label><input asp-for="BidSecurityExpiry" class="form-control" /></div>
    </div></div>
    <div class="card mb-3"><div class="card-body p-0"><table class="table mb-0">
        <thead><tr><th>@L["Hạng mục"]</th><th>@L["ĐVT"]</th><th class="money">SL</th><th style="width:190px">@L["Đơn giá dự thầu"]</th><th class="money">@L["Thành tiền"]</th></tr></thead>
        <tbody>
        @for (var i = 0; i < Model.Lines.Count; i++)
        {
            <tr>
                <td>@Model.Lines[i].Description<input type="hidden" asp-for="Lines[i].RfqLineId" /></td>
                <td>@Model.Lines[i].Unit</td>
                <td class="money qty" data-q="@Model.Lines[i].Quantity.ToString(inv)">@Model.Lines[i].Quantity.ToQty()</td>
                <td><input name="Lines[@i].UnitPrice" type="number" min="0" step="1000" class="form-control form-control-sm price" value="@Model.Lines[i].UnitPrice.ToString(inv)" /></td>
                <td class="money amt">0</td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr class="fw-bold"><td colspan="4" class="text-end">@L["Giá dự thầu (trước VAT)"]</td><td class="money" id="sum">0</td></tr>
            <tr><td colspan="4" class="text-end">@L["Giá đánh giá (sau giảm giá, gồm VAT)"]</td><td class="money" id="eval">0</td></tr>
        </tfoot>
    </table></div></div>
    <button class="btn btn-primary">@L["Tiếp nhận HSDT (niêm phong)"]</button>
    <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-light">@L["Hủy"]</a>
</form>
@section Scripts {
<script>
    (function () {
        function calc() {
            let s = 0;
            document.querySelectorAll('tbody tr').forEach(tr => {
                const a = Math.round((parseFloat(tr.querySelector('.qty').dataset.q) || 0) * (parseFloat(tr.querySelector('.price').value) || 0));
                s += a; tr.querySelector('.amt').textContent = a.toLocaleString('vi-VN');
            });
            const d = parseFloat(document.getElementById('disc').value) || 0, v = parseFloat(document.getElementById('vat').value) || 0;
            document.getElementById('sum').textContent = s.toLocaleString('vi-VN');
            document.getElementById('eval').textContent = Math.round(s * (1 - d / 100) * (1 + v / 100)).toLocaleString('vi-VN');
        }
        document.addEventListener('input', calc); document.getElementById('vat').addEventListener('change', calc); calc();
    })();
</script>
}

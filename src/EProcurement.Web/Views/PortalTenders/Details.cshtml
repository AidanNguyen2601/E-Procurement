@model EProcurement.Web.Controllers.PortalTendersController.TenderPage
@{
    Layout = "_PortalLayout";
    var t = Model.Tender; var me = Model.Bidder; var latest = Model.Latest; var lines = t.Lines.ToList();
    var now = DateTime.Now;
    var secNeedDate = t.ClosingAt.Date.AddDays(t.BidValidityDays + 30);
    var opened = t.OpenedAt.HasValue;
    var steps = new (string Name, bool Done, bool Current)[]
    {
        ("Nhận HSMT", me != null, me == null && Model.Open),
        ("Nộp HSDT", me?.Submitted == true, me != null && !me.Submitted && Model.Open),
        ("Mở thầu", opened, !opened && !Model.Open && t.Status == TenderStatus.Published),
        ("Đánh giá", t.Status >= TenderStatus.Awarded && t.Status != TenderStatus.Cancelled, t.Status is TenderStatus.Opened or TenderStatus.PendingResultApproval),
        ("Kết quả & kiến nghị", t.Status == TenderStatus.Contracted, t.Status == TenderStatus.Awarded)
    };
}
<div class="card mb-3"><div class="card-body">
    <div class="d-flex flex-wrap justify-content-between gap-2">
        <div>
            <h5 class="mb-1">@t.Title</h5>
            <div class="small text-muted mb-2">@t.EnvelopeMethod.GetDisplayName() · @t.EvaluationMethod.GetDisplayName() · Hợp đồng @t.ContractType, @t.ContractDurationDays ngày@(t.IsFramework ? " (hợp đồng khung)" : "")</div>
        </div>
        <div class="text-end">
            <span class="badge bg-light text-dark border">@t.Status.GetDisplayName()</span>
            @if (Model.Open) { <div class="small mt-1">Còn <b data-countdown="@((int)(t.ClosingAt - now).TotalSeconds)"></b> đến đóng thầu</div> }
        </div>
    </div>
    <div class="row g-2 small">
        <div class="col-sm-6 col-lg-3"><span class="text-muted">Phát hành HSMT</span><div>@t.PublishedAt.ToDateTime()</div></div>
        <div class="col-sm-6 col-lg-3"><span class="text-muted">Đóng thầu</span><div class="fw-semibold">@t.ClosingAt.ToDateTime()</div></div>
        <div class="col-sm-6 col-lg-3"><span class="text-muted">Hạn đề nghị làm rõ HSMT</span><div>@Model.QuestionDeadline.ToDateTime()</div></div>
        <div class="col-sm-6 col-lg-3"><span class="text-muted">Mở thầu</span><div>@(opened ? t.OpenedAt.ToDateTime() : "Ngay sau đóng thầu")</div></div>
        <div class="col-sm-6 col-lg-3"><span class="text-muted">Bảo đảm dự thầu</span><div>@(t.BidSecurityAmount > 0 ? t.BidSecurityAmount.ToMoney() + " đ, hiệu lực đến ≥ " + secNeedDate.ToDate() : "Không yêu cầu")</div></div>
        <div class="col-sm-6 col-lg-3"><span class="text-muted">Hiệu lực HSDT tối thiểu</span><div>@t.BidValidityDays ngày</div></div>
        <div class="col-sm-6 col-lg-3"><span class="text-muted">Bảo đảm thực hiện HĐ</span><div>@t.PerformanceSecurityPercent.ToString("0.#")% giá hợp đồng</div></div>
        <div class="col-sm-6 col-lg-3"><span class="text-muted">Bên mời thầu</span><div>@t.Buyer?.FullName</div></div>
    </div>
    <div class="d-flex flex-wrap gap-1 mt-3 small">
        @foreach (var st in steps)
        {
            <span class="badge @(st.Done ? "bg-success" : st.Current ? "bg-primary" : "bg-light text-muted border")">@(st.Done ? "✓ " : "")@st.Name</span>
        }
    </div>
</div></div>

@if (t.Status is TenderStatus.Awarded or TenderStatus.Contracted && t.AwardedVendor != null)
{
    <div class="alert @(t.AwardedVendorId == MyVendorId() ? "alert-success" : "alert-secondary")">Kết quả lựa chọn nhà thầu: <b>@t.AwardedVendor.Name</b>, giá trúng thầu @t.AwardPrice?.ToMoney() đ (trước VAT).</div>
}
@if (Model.AmendmentsAfterSubmit.Any())
{
    <div class="alert alert-warning"><b>HSMT đã được sửa đổi sau khi quý công ty nộp HSDT</b> (@Model.AmendmentsAfterSubmit.Count lần, gần nhất @Model.AmendmentsAfterSubmit.Last().CreatedAt.ToDateTime()).
        Xem nội dung sửa đổi bên dưới và nộp lại HSDT nếu cần – bản nộp sau thay thế bản trước.</div>
}

<div class="row g-3">
<div class="col-lg-7">
    @* ---------------- HSMT ---------------- *@
    <div class="card mb-3"><div class="card-header">Hồ sơ mời thầu</div><div class="card-body small">
        <div class="row g-3">
            <div class="col-md-6"><b>Yêu cầu kỹ thuật</b><div class="pre">@t.TechnicalRequirements</div></div>
            <div class="col-md-6"><b>Tiêu chí năng lực, kinh nghiệm</b><div class="pre">@t.QualificationCriteria</div></div>
            @if (!string.IsNullOrEmpty(t.ContractTerms)) { <div class="col-12"><b>Điều kiện hợp đồng</b><div class="pre">@t.ContractTerms</div></div> }
        </div>
        <div class="table-responsive mt-3"><table class="table table-sm mb-0">
            <thead><tr><th>#</th><th>Phạm vi cung cấp</th><th>ĐVT</th><th class="money">Khối lượng</th></tr></thead><tbody>
            @for (var i = 0; i < lines.Count; i++) { <tr><td>@(i + 1)</td><td>@lines[i].Description</td><td>@lines[i].Unit</td><td class="money">@lines[i].Quantity.ToQty()</td></tr> }
        </tbody></table></div>
    </div>
    <ul class="list-group list-group-flush">
        @foreach (var f in Model.Files)
        {
            <li class="list-group-item small d-flex justify-content-between gap-2">
                <span><a asp-action="Document" asp-route-id="@t.Id" asp-route-fileId="@f.Id">@Icon.Svg("file-text", 14) @f.FileName</a>
                    <span class="text-muted">· @((f.Size / 1024m).ToString("N0")) KB · @f.UploadedAt.ToDateTime()</span>
                    @if (!string.IsNullOrEmpty(f.Note)) { <div>@f.Note</div> }</span>
            </li>
        }
        @if (!Model.Files.Any()) { <li class="list-group-item small text-muted">Bên mời thầu chưa đăng tải file HSMT – nội dung HSMT như trên.</li> }
    </ul></div>

    @* ---------------- Làm rõ / sửa đổi ---------------- *@
    <div class="card mb-3"><div class="card-header">Làm rõ & sửa đổi HSMT (@t.Clarifications.Count)</div>
    <ul class="list-group list-group-flush small">
        @foreach (var c in t.Clarifications.OrderBy(c => c.CreatedAt))
        {
            var isNew = me?.SubmittedAt != null && c.IsAmendment && c.CreatedAt > me.SubmittedAt;
            <li class="list-group-item @(isNew ? "bg-warning-subtle" : "")">@if (c.IsAmendment) { <span class="badge bg-warning text-dark">Sửa đổi</span> } <span class="text-muted">@c.CreatedAt.ToDateTime()</span>
                @if (isNew) { <span class="badge bg-danger">Sau lần nộp HSDT của bạn</span> }
                @if (!string.IsNullOrEmpty(c.Question)) { <div><b>Hỏi:</b> @c.Question</div> }<div class="pre">@c.Answer</div></li>
        }
        @if (!t.Clarifications.Any()) { <li class="list-group-item text-muted">Chưa có nội dung làm rõ / sửa đổi.</li> }
    </ul>
    @if (Model.MyQuestions.Any())
    {
        <div class="card-body border-top small"><div class="fw-semibold mb-1">Đề nghị làm rõ của quý công ty</div>
        @foreach (var q in Model.MyQuestions)
        {
            <div class="mb-2"><span class="text-muted">@q.AskedAt.ToDateTime()</span>
                @if (q.Clarification != null) { <span class="badge bg-success">Đã trả lời @q.Clarification.CreatedAt.ToDateTime()</span> } else { <span class="badge bg-secondary">Chờ trả lời</span> }
                <div class="pre">@q.Content</div></div>
        }
        </div>
    }
    @if (Model.CanAsk)
    {
        <div class="card-body border-top"><form asp-action="Ask" asp-route-id="@t.Id" method="post">
            <textarea name="content" rows="2" maxlength="2000" class="form-control form-control-sm" placeholder="Nội dung đề nghị làm rõ HSMT" required></textarea>
            <div class="d-flex justify-content-between align-items-center mt-1"><span class="small text-muted">Hạn gửi: @Model.QuestionDeadline.ToDateTime(). Trả lời được đăng công khai, không nêu tên nhà thầu hỏi.</span>
                <button class="btn btn-sm btn-outline-primary">Gửi đề nghị làm rõ</button></div>
        </form></div>
    }
    else if (Model.Open && me != null && now > Model.QuestionDeadline)
    {
        <div class="card-body border-top small text-muted">Đã hết hạn gửi đề nghị làm rõ HSMT (@Model.QuestionDeadline.ToDateTime()).</div>
    }
    </div>

    @* ---------------- Biên bản mở thầu ---------------- *@
    @if (opened && me != null)
    {
        var bids = t.Bidders.Where(b => b.Submitted).OrderBy(b => b.Vendor?.Name).ToList();
        <div class="card mb-3"><div class="card-header">Biên bản mở thầu – @t.OpenedAt.ToDateTime() (@bids.Count HSDT)</div>
        <div class="table-responsive"><table class="table table-sm mb-0 small">
            <thead><tr><th>Nhà thầu</th><th class="money">Giá dự thầu (trước VAT)</th><th class="money">Giảm giá</th><th class="money">Bảo đảm dự thầu</th><th class="money">Hiệu lực HSDT</th><th class="money">Tiến độ</th></tr></thead><tbody>
            @foreach (var b in bids)
            {
                <tr class="@(b.VendorId == MyVendorId() ? "table-primary" : "")"><td>@b.Vendor?.Name</td>
                    <td class="money">@(Model.PricesVisible ? b.BidPrice.ToMoney() : "Niêm phong")</td>
                    <td class="money">@(Model.PricesVisible ? b.DiscountPercent.ToString("0.##") + "%" : "–")</td>
                    <td class="money">@b.BidSecurityAmount.ToMoney()</td><td class="money">@b.ValidityDays ngày</td><td class="money">@b.LeadTimeDays ngày</td></tr>
            }
        </tbody></table></div>
        @if (!Model.PricesVisible) { <div class="card-body small text-muted border-top">Hai túi hồ sơ: giá dự thầu được mở sau khi đánh giá kỹ thuật, chỉ với HSDT đạt kỹ thuật.</div> }
        else if (t.FinancialOpenedAt.HasValue) { <div class="card-body small text-muted border-top">Mở hồ sơ tài chính lúc @t.FinancialOpenedAt.ToDateTime().</div> }
        </div>
    }
</div>

<div class="col-lg-5">
    @* ---------------- Kết quả của quý công ty ---------------- *@
    @if (Model.MyResult is BidResult r)
    {
        var won = t.AwardedVendorId == MyVendorId();
        <div class="card mb-3 @(won ? "border-success" : "")"><div class="card-header d-flex justify-content-between">Kết quả đánh giá HSDT của quý công ty
            <a asp-action="ResultNotice" asp-route-id="@t.Id" class="small">Thông báo kết quả</a></div>
        <ul class="list-group list-group-flush small">
            <li class="list-group-item d-flex justify-content-between"><span>Tính hợp lệ</span><span>@Pass(r.Bid.Valid)</span></li>
            <li class="list-group-item d-flex justify-content-between"><span>Năng lực, kinh nghiệm</span><span>@Pass(r.Bid.Qualified)</span></li>
            <li class="list-group-item d-flex justify-content-between"><span>Kỹ thuật (tối thiểu @t.MinTechnicalScore)</span>
                <span>@(r.TechnicalAverage.HasValue ? r.TechnicalAverage.Value.ToString("0.##") + " điểm – " : "")@Pass(r.Responsive ? r.TechnicalPass : null)</span></li>
            @if (r.TechnicalPass)
            {
                <li class="list-group-item d-flex justify-content-between"><span>Giá đánh giá (sau giảm giá, gồm VAT)</span><span>@r.Bid.EvaluatedPrice.ToMoney() đ</span></li>
                <li class="list-group-item d-flex justify-content-between"><span>Xếp hạng</span><b>@r.Rank</b></li>
            }
            <li class="list-group-item @(won ? "list-group-item-success" : "")">@(won ? "Quý công ty trúng thầu. Chuẩn bị bảo đảm thực hiện hợp đồng và hoàn thiện, ký hợp đồng sau thời hạn kiến nghị."
                : r.Rank.HasValue ? $"Không được lựa chọn – xếp hạng thứ {r.Rank}." : "Không được lựa chọn: " + string.Join("; ", r.Issues) + ".")</li>
        </ul></div>
    }

    @* ---------------- Kiến nghị ---------------- *@
    @if (me?.Submitted == true && t.Status is TenderStatus.Awarded or TenderStatus.Contracted || Model.MyComplaints.Any())
    {
        <div class="card mb-3"><div class="card-header">Kiến nghị kết quả @if (t.ComplaintDeadline.HasValue) { <span class="small fw-normal">– hạn @t.ComplaintDeadline.ToDateTime()</span> }</div>
        <ul class="list-group list-group-flush small">
            @foreach (var c in Model.MyComplaints)
            {
                <li class="list-group-item"><span class="text-muted">@c.ReceivedAt.ToDateTime()</span>
                    @if (c.ResolvedAt == null) { <span class="badge bg-secondary">Đang giải quyết</span> }
                    else if (c.Upheld == true) { <span class="badge bg-success">Được chấp nhận – đánh giá lại</span> }
                    else { <span class="badge bg-dark">Không chấp nhận</span> }
                    <div class="pre">@c.Content</div>
                    @if (!string.IsNullOrEmpty(c.Response)) { <div class="pre mt-1 ps-2 border-start"><b>Trả lời (@c.ResolvedAt.ToDateTime()):</b> @c.Response</div> }</li>
            }
            @if (!Model.MyComplaints.Any()) { <li class="list-group-item text-muted">Quý công ty chưa gửi kiến nghị.</li> }
        </ul>
        @if (Model.CanComplain)
        {
            <div class="card-body border-top"><form asp-action="Complain" asp-route-id="@t.Id" method="post" data-confirm="Gửi kiến nghị về kết quả lựa chọn nhà thầu?">
                <textarea name="content" rows="3" maxlength="2000" class="form-control form-control-sm" placeholder="Nội dung kiến nghị, căn cứ" required></textarea>
                <button class="btn btn-sm btn-outline-danger mt-1">Gửi kiến nghị</button>
            </form></div>
        }
        </div>
    }

    @* ---------------- Đăng ký / HSDT ---------------- *@
    @if (me == null)
    {
        @if (Model.Open && Model.CanTrade) { <form asp-action="Register" asp-route-id="@t.Id" method="post" class="mb-3"><button class="btn btn-primary w-100">Đăng ký nhận HSMT / tham dự thầu</button></form> }
        else if (Model.Open) { <div class="alert alert-warning">Tài khoản cần được xác nhận trước khi tham dự thầu.</div> }
    }
    else
    {
        @if (latest != null)
        {
            <div class="card mb-3 border-success"><div class="card-body small">
                <b>Biên nhận HSDT online</b> – lần @latest.Revision, nộp lúc @latest.SubmittedAt.ToString("dd/MM/yyyy HH:mm:ss")<br />
                File: @latest.FileName (@((latest.FileSize / 1024m).ToString("N0")) KB)<br />
                Mã băm SHA-256: <code class="text-break">@latest.Sha256</code><br />
                @(t.OpenedAt == null ? "Đang niêm phong đến thời điểm mở thầu." : $"Đã mở thầu lúc {t.OpenedAt:dd/MM/yyyy HH:mm}.")
                <div class="mt-1"><a asp-action="Receipt" asp-route-id="@t.Id" asp-route-submissionId="@latest.Id" class="btn btn-sm btn-outline-secondary">In biên nhận</a>
                @if (Model.Open) { <form asp-action="Withdraw" asp-route-id="@t.Id" method="post" class="d-inline ms-2" data-confirm="Rút HSDT đã nộp? Nếu không nộp lại trước đóng thầu, quý công ty không tham dự gói thầu."><button class="btn btn-sm btn-link text-danger p-0">Rút HSDT</button></form> }</div>
            </div></div>
        }
        else if (me.Submitted) { <div class="alert alert-info">HSDT bản giấy đã được bên mời thầu tiếp nhận.</div> }
        else if (!Model.Open) { <div class="alert alert-secondary">Đã đóng thầu – quý công ty không nộp HSDT.</div> }

        @if (Model.Submissions.Count > 1 || Model.Submissions.Any(x => x.IsWithdrawn))
        {
            <div class="card mb-3"><div class="card-header">Lịch sử nộp HSDT</div>
            <div class="table-responsive"><table class="table table-sm mb-0 small">
                <thead><tr><th>Lần</th><th>Thời điểm</th><th>Mã băm</th><th>Trạng thái</th><th></th></tr></thead><tbody>
                @foreach (var x in Model.Submissions)
                {
                    <tr><td>@x.Revision</td><td>@x.SubmittedAt.ToString("dd/MM HH:mm:ss")</td><td><code>@x.Sha256[..10]…</code></td>
                        <td>@(x.IsWithdrawn ? "Đã rút" : x.IsLatest ? (x.UnsealedAt != null ? "Đã mở" : "Hiện hành") : "Đã thay thế")</td>
                        <td><a asp-action="Receipt" asp-route-id="@t.Id" asp-route-submissionId="@x.Id">Biên nhận</a></td></tr>
                }
            </tbody></table></div></div>
        }
    }
</div>
</div>

@if (me != null && Model.Open && Model.CanTrade && !(me.Submitted && latest == null))
{
    <form asp-action="Submit" asp-route-id="@t.Id" method="post" enctype="multipart/form-data" class="card" id="bid-form">
    <div class="card-header">@(latest == null ? "Nộp HSDT online" : "Nộp lại HSDT (thay bản trước)")</div><div class="card-body">
        <div class="table-responsive"><table class="table table-sm align-middle">
            <thead><tr><th>#</th><th>Hàng hóa / dịch vụ</th><th>ĐVT</th><th class="money">Khối lượng</th><th style="width:170px">Đơn giá dự thầu (chưa VAT)</th><th class="money">Thành tiền</th></tr></thead><tbody>
            @for (var i = 0; i < lines.Count; i++)
            {
                <tr><td>@(i + 1)</td><td>@lines[i].Description</td><td>@lines[i].Unit</td><td class="money">@lines[i].Quantity.ToQty()</td>
                    <td><input name="prices" type="number" min="1" step="1" class="form-control form-control-sm text-end bid-price" data-qty="@lines[i].Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></td>
                    <td class="money bid-amount">0</td></tr>
            }
            </tbody>
            <tfoot class="small">
                <tr><td colspan="5" class="text-end">Giá dự thầu (trước VAT)</td><td class="money fw-semibold" id="bid-sub">0</td></tr>
                <tr><td colspan="5" class="text-end">Giảm giá</td><td class="money" id="bid-disc">0</td></tr>
                <tr><td colspan="5" class="text-end">VAT</td><td class="money" id="bid-vat">0</td></tr>
                <tr><td colspan="5" class="text-end fw-semibold">Giá dự thầu sau giảm giá, gồm VAT</td><td class="money fw-bold" id="bid-total">0</td></tr>
            </tfoot>
        </table></div>

        <div class="row g-2">
            <div class="col-6 col-md-2"><label class="form-label small mb-0">Giảm giá (%)</label><input name="discountPercent" id="bid-dp" type="number" min="0" max="99.9" step="0.1" value="0" class="form-control form-control-sm" /></div>
            <div class="col-6 col-md-2"><label class="form-label small mb-0">VAT (%)</label><input name="vatPercent" id="bid-vp" type="number" min="0" max="20" step="0.5" value="10" class="form-control form-control-sm" /></div>
            <div class="col-6 col-md-2"><label class="form-label small mb-0">Tiến độ (ngày)</label><input name="leadTimeDays" type="number" min="0" max="3650" value="@t.ContractDurationDays" class="form-control form-control-sm" required /></div>
            <div class="col-6 col-md-2"><label class="form-label small mb-0">Hiệu lực HSDT (ngày)</label><input name="validityDays" type="number" min="@t.BidValidityDays" value="@t.BidValidityDays" class="form-control form-control-sm" required title="Tối thiểu @t.BidValidityDays ngày" /></div>
            <div class="col-md-4"><label class="form-label small mb-0">Ghi chú</label><input name="note" maxlength="1000" class="form-control form-control-sm" /></div>
            @if (t.BidSecurityAmount > 0)
            {
                <div class="col-md-4"><label class="form-label small mb-0">Bảo đảm dự thầu (đ, tối thiểu @t.BidSecurityAmount.ToMoney())</label><input name="bidSecurityAmount" type="number" min="@t.BidSecurityAmount.ToString("0")" value="@t.BidSecurityAmount.ToString("0")" class="form-control form-control-sm" required /></div>
                <div class="col-md-4"><label class="form-label small mb-0">Số bảo lãnh / chứng từ</label><input name="bidSecurityRef" maxlength="100" class="form-control form-control-sm" required /></div>
                <div class="col-md-4"><label class="form-label small mb-0">Bảo lãnh hiệu lực đến (≥ @secNeedDate.ToDate())</label><input name="bidSecurityExpiry" type="date" min="@secNeedDate.ToString("yyyy-MM-dd")" value="@secNeedDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" required /></div>
            }
            else { <input type="hidden" name="bidSecurityAmount" value="0" /> }
        </div>

        <div class="fw-semibold small mt-3 mb-1">Thành phần HSDT (mỗi file ≤ @Model.MaxFileMb MB: pdf, doc(x), xls(x), zip, rar, 7z, jpg, png)</div>
        <div class="row g-2 small">
            <div class="col-md-6"><label class="form-label mb-0">Đề xuất kỹ thuật <span class="text-danger">*</span></label><input name="techFile" type="file" class="form-control form-control-sm" required /></div>
            <div class="col-md-6"><label class="form-label mb-0">Đề xuất tài chính @if (t.EnvelopeMethod == EnvelopeMethod.TwoEnvelope) { <span class="text-muted">(niêm phong riêng, chỉ mở nếu đạt kỹ thuật)</span> }</label><input name="finFile" type="file" class="form-control form-control-sm" /></div>
            <div class="col-md-6"><label class="form-label mb-0">Bảo đảm dự thầu (bản scan)</label><input name="securityFile" type="file" class="form-control form-control-sm" /></div>
            <div class="col-md-6"><label class="form-label mb-0">Năng lực, kinh nghiệm</label><input name="qualFile" type="file" class="form-control form-control-sm" /></div>
            <div class="col-12"><label class="form-label mb-0">Tài liệu khác (tối đa 5 file)</label><input name="otherFiles" type="file" multiple class="form-control form-control-sm" /></div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
            <button class="btn btn-primary" data-confirm="Nộp HSDT? Nội dung được niêm phong đến thời điểm mở thầu.">Nộp HSDT</button>
            <span class="small text-muted">Có thể nộp lại nhiều lần trước đóng thầu – chỉ bản cuối cùng được mở.</span>
        </div>
    </div></form>
}

@functions {
    int MyVendorId() => (ViewBag.PortalUser as VendorUser)?.VendorId ?? 0;
    static string Pass(bool? v) => v == null ? "Chưa đánh giá" : v.Value ? "Đạt" : "Không đạt";
}

@section Scripts {
<script>
(function () {
    const form = document.getElementById('bid-form');
    if (!form) return;
    const fmt = n => Math.round(n).toLocaleString('vi-VN');
    const num = el => parseFloat(el && el.value ? el.value : '0') || 0;
    function recalc() {
        let sub = 0;
        form.querySelectorAll('.bid-price').forEach(inp => {
            const a = num(inp) * parseFloat(inp.dataset.qty || '0');
            inp.closest('tr').querySelector('.bid-amount').textContent = fmt(a);
            sub += a;
        });
        const disc = sub * num(document.getElementById('bid-dp')) / 100;
        const vat = (sub - disc) * num(document.getElementById('bid-vp')) / 100;
        document.getElementById('bid-sub').textContent = fmt(sub);
        document.getElementById('bid-disc').textContent = disc ? '−' + fmt(disc) : '0';
        document.getElementById('bid-vat').textContent = fmt(vat);
        document.getElementById('bid-total').textContent = fmt(sub - disc + vat);
    }
    form.addEventListener('input', recalc);
    form.querySelector('[name=otherFiles]').addEventListener('change', e => {
        if (e.target.files.length > 5) { alert('Tối đa 5 file tài liệu khác.'); e.target.value = ''; }
    });
    recalc();
})();
</script>
}

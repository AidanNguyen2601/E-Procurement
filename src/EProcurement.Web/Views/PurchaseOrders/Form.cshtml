@model PoFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Tạo đơn mua hàng" : $"Sửa đơn mua hàng {Model.Number}";
    ViewData["PriceLabel"] = "Đơn giá (trước VAT)";
    ViewData["ItemsJson"] = ViewBag.ItemsJson;
    var pr = ViewBag.PurchaseRequest as PurchaseRequest;
}
<form asp-action="Save" method="post">
    <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="PurchaseRequestId" /><input type="hidden" asp-for="RfqId" />
    <div asp-validation-summary="All" class="text-danger"></div>
    @if (pr != null) { <div class="alert alert-info py-2">Lập từ đề nghị <b>@pr.Number</b> – @pr.Title (dự toán @pr.EstimatedTotal.ToMoney() đ)</div> }
    <div class="card mb-3"><div class="card-body row g-3">
        <div class="col-md-2"><label asp-for="Number" class="form-label"></label><input asp-for="Number" class="form-control" readonly /></div>
        <div class="col-md-6"><label asp-for="VendorId" class="form-label"></label><select asp-for="VendorId" class="form-select" asp-items="ViewBag.Vendors"><option value="">-- Chọn NCC đã phê duyệt --</option></select><span asp-validation-for="VendorId" class="text-danger small"></span></div>
        <div class="col-md-2"><label asp-for="OrderDate" class="form-label"></label><input asp-for="OrderDate" class="form-control" /></div>
        <div class="col-md-2"><label asp-for="DeliveryDate" class="form-label"></label><input asp-for="DeliveryDate" class="form-control" /><span asp-validation-for="DeliveryDate" class="text-danger small"></span></div>
        <div class="col-md-5"><label asp-for="DeliveryAddress" class="form-label"></label><input asp-for="DeliveryAddress" class="form-control" /></div>
        <div class="col-md-5"><label asp-for="PaymentTerms" class="form-label"></label><input asp-for="PaymentTerms" class="form-control" placeholder="Để trống = theo điều khoản của NCC" /></div>
        <div class="col-md-2"><label asp-for="VatPercent" class="form-label"></label><select asp-for="VatPercent" class="form-select" id="vat"><option value="0">0%</option><option value="5">5%</option><option value="8">8%</option><option value="10">10%</option></select></div>
        <div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
    </div></div>
    <partial name="_LineEditor" model="Model.Lines" />
    <div class="text-end mb-3">VAT: <b id="vatAmt">0</b> · Tổng thanh toán: <b class="fs-5" id="grand">0</b> đ</div>
    <button class="btn btn-outline-primary" name="submit" value="false">Lưu nháp</button>
    <button class="btn btn-primary" name="submit" value="true">Lưu & trình duyệt</button>
    <a asp-action="Index" class="btn btn-light">Hủy</a>
</form>
@section Scripts {
<script>
    let sub = 0;
    function grand() { const v = parseFloat(document.getElementById('vat').value) || 0; const va = Math.round(sub * v / 100);
        document.getElementById('vatAmt').textContent = va.toLocaleString('vi-VN'); document.getElementById('grand').textContent = Math.round(sub + va).toLocaleString('vi-VN'); }
    document.addEventListener('lines-changed', e => { sub = e.detail; grand(); });
    document.getElementById('vat').addEventListener('change', grand);
    document.querySelector('.line-editor').dispatchEvent(new Event('input', { bubbles: true }));
    document.querySelector('.line-editor .calc')?.dispatchEvent(new Event('input', { bubbles: true }));
</script>
}

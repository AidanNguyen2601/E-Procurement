@model PoFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Tạo đơn mua hàng" : $"Sửa đơn mua hàng {Model.Number}";
    ViewData["PriceLabel"] = "Đơn giá (trước VAT)";
    ViewData["ItemsJson"] = ViewBag.ItemsJson;
    var pr = ViewBag.PurchaseRequest as PurchaseRequest;
    var reference = ViewBag.Reference as ReferencePoCandidate;
}
<form asp-action="Save" method="post">
    <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="PurchaseRequestId" /><input type="hidden" asp-for="PackageId" />
    <partial name="_PackageBanner" model="ViewBag.Package as ProcurementPackage" /><input type="hidden" asp-for="RfqId" /><input type="hidden" asp-for="ReferencePoId" />
    <div asp-validation-summary="All" class="text-danger"></div>
    @if (pr != null) { <div class="alert alert-info py-2">Lập từ đề nghị <b>@pr.Number</b> – @pr.Title (dự toán @pr.EstimatedTotal.ToMoney() đ)</div> }
    @if (reference != null)
    {
        decimal maxPercent = ViewBag.MaxPercent;
        <div class="card mb-3 border-success">
            <div class="card-header">Mua sắm trực tiếp – căn cứ PO <b>@reference.Po.Number</b> (@reference.Po.Vendor?.Name, đặt ngày @reference.Po.OrderDate.ToDate())</div>
            <div class="card-body p-0">
                <table class="table table-sm small mb-0">
                    <thead><tr><th>Mặt hàng trong PO tham chiếu</th><th class="money">Đơn giá tối đa</th><th class="money">Còn được mua (≤ @maxPercent.ToString("0")%)</th></tr></thead>
                    <tbody>
                    @foreach (var l in reference.Po.Lines.Where(l => l.ItemId.HasValue).GroupBy(l => l.ItemId!.Value))
                    {
                        <tr><td>@l.First().Description</td><td class="money">@reference.PriceByItem[l.Key].ToMoney()</td><td class="money">@reference.RemainingByItem[l.Key].ToQty() @l.First().Unit</td></tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="card-body pt-2">
                <label asp-for="PriceDeviationReason" class="form-label small"></label>
                <input asp-for="PriceDeviationReason" class="form-control form-control-sm" placeholder="Chỉ nhập khi có dòng đơn giá cao hơn PO tham chiếu – đơn sẽ phải trình Giám đốc duyệt" />
                <span asp-validation-for="PriceDeviationReason" class="text-danger small"></span>
            </div>
        </div>
    }
    <div class="card mb-3"><div class="card-body row g-3">
        <div class="col-md-2"><label asp-for="Number" class="form-label"></label><input asp-for="Number" class="form-control" readonly /></div>
        @if (reference != null)
        {
            <div class="col-md-6"><label asp-for="VendorId" class="form-label"></label><input type="hidden" asp-for="VendorId" />
                <input class="form-control" value="@reference.Po.Vendor?.Name" readonly title="Mua sắm trực tiếp: cùng NCC với PO tham chiếu" /><span asp-validation-for="VendorId" class="text-danger small"></span></div>
        }
        else
        {
            <div class="col-md-6"><label asp-for="VendorId" class="form-label"></label><select asp-for="VendorId" class="form-select" asp-items="ViewBag.Vendors"><option value="">-- Chọn NCC đã phê duyệt --</option></select><span asp-validation-for="VendorId" class="text-danger small"></span></div>
        }
        <div class="col-md-2"><label asp-for="OrderDate" class="form-label"></label><input asp-for="OrderDate" class="form-control" /></div>
        <div class="col-md-2"><label asp-for="DeliveryDate" class="form-label"></label><input asp-for="DeliveryDate" class="form-control" /><span asp-validation-for="DeliveryDate" class="text-danger small"></span></div>
        <div class="col-md-5"><label asp-for="DeliveryAddress" class="form-label"></label><input asp-for="DeliveryAddress" class="form-control" list="dl-deliverylocation" />@await Catalog.DatalistAsync(CatalogType.DeliveryLocation)</div>
        <div class="col-md-5"><label asp-for="PaymentTerms" class="form-label"></label><input asp-for="PaymentTerms" class="form-control" placeholder="Để trống = theo điều khoản của NCC" list="dl-paymentterm" />@await Catalog.DatalistAsync(CatalogType.PaymentTerm)</div>
        <div class="col-md-2"><label asp-for="VatPercent" class="form-label"></label><select asp-for="VatPercent" class="form-select" id="vat"><option value="0">0%</option><option value="5">5%</option><option value="8">8%</option><option value="10">10%</option></select></div>
        <div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
    </div></div>
    <partial name="_LineEditor" model="Model.Lines" />
    <div class="text-end mb-3">VAT: <b id="vatAmt">0</b> · Tổng thanh toán: <b class="fs-5" id="grand">0</b> đ</div>
    <div class="mb-3"><label asp-for="StandardPriceReason" class="form-label small"></label>
        <input asp-for="StandardPriceReason" class="form-control form-control-sm" placeholder="Chỉ nhập khi có dòng đơn giá vượt giá trần bảng giá tiêu chuẩn – đơn sẽ phải trình Giám đốc duyệt" />
        <span asp-validation-for="StandardPriceReason" class="text-danger small"></span></div>
    <button class="btn btn-outline-primary" name="submit" value="false">Lưu nháp</button>
    <button class="btn btn-primary" name="submit" value="true">Lưu & trình duyệt</button>
    <a asp-action="Index" class="btn btn-light">Hủy</a>
</form>
@section Scripts {
<script>
    let sub = 0;
    function grand() { const v = parseFloat(document.getElementById('vat').value) || 0; const va = Math.round(sub * v / 100);
        document.getElementById('vatAmt').textContent = va.toLocaleString('vi-VN'); document.getElementById('grand').textContent = Math.round(sub + va).toLocaleString('vi-VN'); }
    document.addEventListener('lines-changed', e => { sub = e.detail; grand(); });
    document.getElementById('vat').addEventListener('change', grand);
    document.querySelector('.line-editor').dispatchEvent(new Event('input', { bubbles: true }));
    document.querySelector('.line-editor .calc')?.dispatchEvent(new Event('input', { bubbles: true }));
</script>
}

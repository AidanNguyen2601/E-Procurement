@model List<PurchaseOrder>
@{
    ViewData["Title"] = "Đơn mua hàng (PO)";
    var status = ViewBag.Status as PoStatus?;
    var statusItems = Html.GetEnumSelectList<PoStatus>().ToList();
    foreach (var i in statusItems) i.Selected = status.HasValue && i.Value == ((int)status.Value).ToString();
}
<form method="get" class="toolbar">
    <div><label class="form-label small mb-1">@L["Tìm kiếm"]</label><input name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="@L["Số PO, nhà cung cấp"]" /></div>
    <div><label class="form-label small mb-1">@L["Trạng thái"]</label><select name="status" class="form-select" asp-items="statusItems"><option value="">@L["-- Tất cả --"]</option></select></div>
    <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="late" value="true" id="late" @(ViewBag.Late == true ? "checked" : "") /><label class="form-check-label" for="late">@L["Chỉ PO trễ hạn giao"]</label></div>
    <button class="btn btn-outline-primary">@L["Lọc"]</button>
    @if (User.IsPurchasing()) { <a class="btn btn-primary ms-auto" asp-action="Create">@L["+ Tạo PO"]</a> }
</form>
<div class="card"><div class="card-body p-0"><table class="table table-hover mb-0">
    <thead><tr><th>@L["Số PO"]</th><th>@L["Nhà cung cấp"]</th><th>@L["Ngày đặt"]</th><th>@L["Ngày giao"]</th><th class="money">@L["Tổng giá trị"]</th><th>@L["Người lập"]</th><th>@L["Trạng thái"]</th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr class="@(p.IsLate ? "table-danger" : "")">
            <td><a asp-action="Details" asp-route-id="@p.Id" class="fw-semibold">@p.Number</a></td>
            <td>@p.Vendor?.Name</td><td>@p.OrderDate.ToDate()</td>
            <td>@p.DeliveryDate.ToDate() @if (p.IsLate) { <b class="text-danger small">@L["trễ"] @((DateTime.Today - p.DeliveryDate).Days) @L["ngày"]</b> }</td>
            <td class="money">@p.Total.ToMoney()</td><td>@p.Buyer?.FullName</td>
            <td><partial name="_Badge" model="p.Status" /></td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted p-4">@L["Không có đơn hàng."]</td></tr> }
    </tbody>
</table></div></div>

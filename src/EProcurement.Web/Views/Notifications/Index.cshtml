@model List<Notification>
@{
    var total = (int)ViewBag.Total; var page = (int)ViewBag.Page; var size = (int)ViewBag.Size; var unread = (bool)ViewBag.Unread;
    var pages = Math.Max(1, (int)Math.Ceiling(total / (double)size));
}
<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <div class="btn-group btn-group-sm">
        <a asp-action="Index" class="btn @(unread ? "btn-outline-primary" : "btn-primary")">Tất cả</a>
        <a asp-action="Index" asp-route-unread="true" class="btn @(unread ? "btn-primary" : "btn-outline-primary")">Chưa đọc</a>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="MarkAllRead" method="post"><button class="btn btn-sm btn-light">Đánh dấu tất cả đã đọc</button></form>
        @if (User.IsAdmin()) { <form asp-action="RunNow" method="post"><button class="btn btn-sm btn-outline-secondary" title="Bình thường hệ thống tự quét theo chu kỳ">Quét nhắc hạn ngay</button></form> }
    </div>
</div>
<div class="card mb-3"><div class="card-body p-0"><table class="table mb-0 align-middle">
    <tbody>
    @foreach (var n in Model)
    {
        <tr class="@(n.ReadAt == null ? "fw-semibold" : "text-muted")">
            <td style="width:36px"><span class="notif-kind k@((int)n.Kind)">@Icon.Svg(n.Kind switch { NotificationKind.Action => "inbox", NotificationKind.Reminder => "clock", NotificationKind.Warning => "alert", _ => "bell" }, 14)</span></td>
            <td><a asp-action="Open" asp-route-id="@n.Id" class="text-reset">@n.Title</a>
                @if (!string.IsNullOrEmpty(n.Message)) { <div class="small text-muted fw-normal">@n.Message</div> }</td>
            <td class="small text-nowrap fw-normal"><span class="badge bg-light text-dark border">@n.Kind.GetDisplayName()</span></td>
            <td class="small text-nowrap text-muted fw-normal">@n.CreatedAt.ToDateTime()</td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td class="text-muted p-3">Không có thông báo.</td></tr> }
    </tbody>
</table></div></div>
@if (pages > 1)
{
    <nav><ul class="pagination pagination-sm">
        @for (var i = 1; i <= pages; i++) { <li class="page-item @(i == page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-unread="@unread">@i</a></li> }
    </ul></nav>
}
<div class="card"><div class="card-body d-flex flex-wrap gap-3 align-items-center justify-content-between">
    <div class="small">
        <b>Nhận thông báo qua email</b>: @(ViewBag.EmailOn ? "đang bật" : "đang tắt")
        <span class="text-muted">· @(string.IsNullOrEmpty((string?)ViewBag.Email) ? "tài khoản chưa có email" : (string)ViewBag.Email)</span>
        <div class="text-muted">Email chỉ được gửi khi quản trị đã cấu hình máy chủ gửi thư (SMTP).</div>
    </div>
    <form asp-action="EmailPreference" method="post"><input type="hidden" name="enabled" value="@((!(bool)ViewBag.EmailOn).ToString().ToLower())" />
        <button class="btn btn-sm btn-outline-primary">@(ViewBag.EmailOn ? "Tắt email" : "Bật email")</button></form>
</div></div>

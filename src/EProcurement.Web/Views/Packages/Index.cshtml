@model List<ProcurementPackage>
@{
    ViewData["Title"] = "Quản lý gói mua sắm";
    var status = ViewBag.Status as PackageStatus?; var method = ViewBag.Method as ProcurementMethod?; int waiting = ViewBag.Waiting;
    var statusItems = Html.GetEnumSelectList<PackageStatus>().ToList();
    foreach (var i in statusItems) i.Selected = status.HasValue && i.Value == ((int)status.Value).ToString();
    var methodItems = Html.GetEnumSelectList<ProcurementMethod>().ToList();
    foreach (var i in methodItems) i.Selected = method.HasValue && i.Value == ((int)method.Value).ToString();
}
@if (waiting > 0 && User.IsPurchasing())
{
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-2">@Icon.Svg("inbox", 16) <span><b>@waiting</b> @L["đề nghị mua hàng đã duyệt chưa được gom vào gói."]</span>
        <a asp-action="Create" class="btn btn-sm btn-primary ms-auto">@L["Lập gói mua sắm"]</a></div>
}
<form method="get" class="toolbar">
    <select name="status" class="form-select form-select-sm" style="width:auto" asp-items="statusItems" onchange="this.form.submit()"><option value="">@L["-- Mọi trạng thái --"]</option></select>
    <select name="method" class="form-select form-select-sm" style="width:auto" asp-items="methodItems" onchange="this.form.submit()"><option value="">@L["-- Mọi hình thức --"]</option></select>
    <input name="q" value="@ViewBag.Q" class="form-control form-control-sm" style="max-width:240px" placeholder="@L["Số gói, tên gói, số PR"]" />
    <button class="btn btn-sm btn-outline-secondary">@L["Lọc"]</button>
    @if (User.IsPurchasing()) { <a asp-action="Create" class="btn btn-sm btn-primary ms-auto">@Icon.Svg("plus", 14) @L["Lập gói"]</a> }
</form>
<div class="card"><div class="card-body p-0"><div class="table-responsive"><table class="table mb-0 align-middle">
    <thead><tr><th>@L["Số gói"]</th><th>@L["Tên gói"]</th><th>@L["Đề nghị"]</th><th>@L["Hình thức"]</th><th class="money">@L["Giá gói"]</th><th>@L["Bắt đầu LCNT"]</th><th>KHLCNT</th><th>@L["Trạng thái"]</th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr><td><a asp-action="Details" asp-route-id="@p.Id" class="fw-semibold">@p.Number</a><br /><small class="text-muted">@p.Buyer?.FullName</small></td>
            <td>@p.Title</td>
            <td class="small">@string.Join(", ", p.PurchaseRequests.OrderBy(r => r.Id).Select(r => r.Number))</td>
            <td class="small">@p.Method.GetDisplayName()@if (p.Method == ProcurementMethod.OpenTender) { <div class="text-muted">@p.EnvelopeMethod.GetDisplayName()</div> }</td>
            <td class="money">@p.Budget.ToMoney()</td>
            <td class="small">@p.PlannedStart.ToDate()</td>
            <td class="small">@if (p.SelectionPlan != null) { <a asp-controller="SelectionPlans" asp-action="Details" asp-route-id="@p.SelectionPlanId">@p.SelectionPlan.Number</a> } else { <span class="text-muted">@L["Chưa đưa vào"]</span> }</td>
            <td><partial name="_Badge" model="p.Status" /></td></tr>
    }
    @if (!Model.Any()) { <tr><td colspan="8" class="text-muted p-3">@L["Chưa có gói mua sắm."]</td></tr> }
    </tbody>
</table></div></div></div>

@model DirectAwardFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Lập tờ trình chỉ định thầu" : $"Sửa tờ trình {Model.Number}";
    decimal max = ViewBag.Max;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var pr = Model.PurchaseRequest;
}
<form asp-action="Save" method="post">
    <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="PurchaseRequestId" />
    <div asp-validation-summary="All" class="text-danger"></div>
    @if (pr != null) { <div class="alert alert-info py-2">Từ đề nghị <b>@pr.Number</b> – @pr.Title (dự toán @pr.EstimatedTotal.ToMoney() đ). Hạn mức chỉ định: <b>@max.ToMoney() đ</b> trước VAT (vượt chỉ khi khẩn cấp).</div> }

    <div class="card mb-3"><div class="card-header">1. Căn cứ chỉ định</div><div class="card-body row g-3">
        <div class="col-md-2"><label asp-for="Number" class="form-label"></label><input asp-for="Number" class="form-control" readonly /></div>
        <div class="col-md-10"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="VendorId" class="form-label"></label>
            <select asp-for="VendorId" class="form-select" asp-items="ViewBag.Vendors"><option value="">-- Chọn NCC đã phê duyệt --</option></select>
            <span asp-validation-for="VendorId" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="Reason" class="form-label"></label>
            <select asp-for="Reason" class="form-select" asp-items="Html.GetEnumSelectList<DirectAwardReason>()"></select>
            <div class="small text-muted">Độc quyền / khẩn cấp / tương thích: bắt buộc đính kèm tài liệu chứng minh trước khi trình.</div></div>
        <div class="col-12"><label asp-for="Justification" class="form-label"></label>
            <textarea asp-for="Justification" class="form-control" rows="3" placeholder="VD: Thiết bị chỉ do hãng X sản xuất, NCC là nhà phân phối độc quyền tại Việt Nam (đính kèm giấy xác nhận)…"></textarea>
            <span asp-validation-for="Justification" class="text-danger small"></span></div>
    </div></div>

    <div class="card mb-3"><div class="card-header">2. Thương thảo với nhà cung cấp</div><div class="card-body row g-3">
        <div class="col-md-3"><label asp-for="NegotiationDate" class="form-label"></label><input asp-for="NegotiationDate" class="form-control" /></div>
        <div class="col-md-2"><label asp-for="LeadTimeDays" class="form-label"></label><input asp-for="LeadTimeDays" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="PaymentTerms" class="form-label"></label><input asp-for="PaymentTerms" class="form-control" placeholder="Để trống = theo NCC" /></div>
        <div class="col-md-2"><label asp-for="Warranty" class="form-label"></label><input asp-for="Warranty" class="form-control" /></div>
        <div class="col-md-2"><label asp-for="VatPercent" class="form-label"></label><select asp-for="VatPercent" class="form-select" id="vat"><option value="0">0%</option><option value="5">5%</option><option value="8">8%</option><option value="10">10%</option></select></div>
        <div class="col-12"><label asp-for="NegotiationNote" class="form-label"></label>
            <textarea asp-for="NegotiationNote" class="form-control" rows="2" placeholder="Thành phần, nội dung đã thống nhất (giảm giá, tiến độ, bảo hành, điều kiện thanh toán…)"></textarea></div>
    </div>
    <div class="card-body p-0"><table class="table mb-0 align-middle">
        <thead><tr><th>Hàng hóa / dịch vụ</th><th>ĐVT</th><th class="money">SL</th><th class="money">Dự toán</th><th style="width:170px">Giá NCC chào</th><th style="width:170px">Giá thương thảo</th><th class="money">Thành tiền</th></tr></thead>
        <tbody>
        @for (var i = 0; i < Model.Lines.Count; i++)
        {
            var l = Model.Lines[i];
            <tr>
                <td>@l.Description</td><td>@l.Unit</td>
                <td class="money qty" data-q="@l.Quantity.ToString(inv)">@l.Quantity.ToQty()</td>
                <td class="money">@l.EstimatedPrice.ToMoney()</td>
                <td><input name="Lines[@i].ProposedPrice" type="number" min="0" step="1000" class="form-control form-control-sm" value="@l.ProposedPrice.ToString(inv)" /></td>
                <td><input name="Lines[@i].NegotiatedPrice" type="number" min="0" step="1000" class="form-control form-control-sm neg" value="@l.NegotiatedPrice.ToString(inv)" /></td>
                <td class="money amt">0</td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr class="fw-bold"><td colspan="6" class="text-end">Tổng sau thương thảo (trước VAT)</td><td class="money" id="sum">0</td></tr>
            <tr><td colspan="6" class="text-end">Tổng gồm VAT</td><td class="money" id="grand">0</td></tr>
        </tfoot>
    </table></div></div>

    <button class="btn btn-outline-primary" name="submit" value="false">Lưu nháp</button>
    <button class="btn btn-primary" name="submit" value="true">Lưu & trình Giám đốc</button>
    <a asp-controller="PurchaseRequests" asp-action="Details" asp-route-id="@Model.PurchaseRequestId" class="btn btn-light">Hủy</a>
</form>
@section Scripts {
<script>
    (function () {
        const max = @max.ToString(inv);
        function calc() {
            let s = 0;
            document.querySelectorAll('tbody tr').forEach(tr => {
                const q = parseFloat(tr.querySelector('.qty').dataset.q) || 0, p = parseFloat(tr.querySelector('.neg').value) || 0;
                const a = Math.round(q * p); s += a; tr.querySelector('.amt').textContent = a.toLocaleString('vi-VN');
            });
            const v = parseFloat(document.getElementById('vat').value) || 0;
            const sum = document.getElementById('sum');
            sum.textContent = s.toLocaleString('vi-VN'); sum.classList.toggle('text-danger', s > max);
            document.getElementById('grand').textContent = Math.round(s * (1 + v / 100)).toLocaleString('vi-VN');
        }
        document.addEventListener('input', calc); document.getElementById('vat').addEventListener('change', calc); calc();
    })();
</script>
}

@model DirectAward
@{
    ViewData["Title"] = $"Tờ trình {Model.Number}";
    var history = (List<ApprovalHistory>)ViewBag.History;
    var attachments = (AttachmentPanel)ViewBag.Attachments;
    var po = ViewBag.Po as PurchaseOrder;
    decimal max = ViewBag.Max;
    var problems = (List<string>)ViewBag.Problems;
    var split = ViewBag.SplitWarning as string;
    var buyer = User.IsPurchasing();
    var canDecide = Model.Status == DirectAwardStatus.PendingApproval && (User.IsInRole(AppRoles.Director) || User.IsAdmin());
    var steps = new (string Name, bool Done, bool Current)[]
    {
        ("Lập tờ trình & thương thảo", Model.Status is DirectAwardStatus.PendingApproval or DirectAwardStatus.Approved, Model.Status == DirectAwardStatus.Draft),
        ("Giám đốc duyệt", Model.Status == DirectAwardStatus.Approved, Model.Status == DirectAwardStatus.PendingApproval),
        ("Lập PO", po != null && po.Status != PoStatus.Draft, Model.Status == DirectAwardStatus.Approved)
    };
}
<div class="card mb-3"><div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div class="flow">
        @for (var i = 0; i < steps.Length; i++)
        {
            <span class="step @(Model.Status == DirectAwardStatus.Cancelled ? "" : steps[i].Done ? "done" : steps[i].Current ? "current" : "")">@steps[i].Name</span>
            @if (i < steps.Length - 1) { <span class="arrow">›</span> }
        }
    </div>
    <partial name="_Badge" model="Model.Status" />
</div></div>

<div class="toolbar">
    @if (buyer && Model.Status == DirectAwardStatus.Draft)
    {
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Sửa / thương thảo</a>
        <form asp-action="Submit" asp-route-id="@Model.Id" method="post"><button class="btn btn-primary" disabled="@(problems.Count > 0)">Trình Giám đốc duyệt</button></form>
    }
    <a class="btn btn-outline-secondary" asp-action="Print" asp-route-id="@Model.Id" target="_blank">In tờ trình & biên bản thương thảo</a>
    @if (po != null) { <a class="btn btn-success" asp-controller="PurchaseOrders" asp-action="Details" asp-route-id="@po.Id">Xem đơn hàng @po.Number</a> }
    @if (buyer && Model.Status is DirectAwardStatus.Draft or DirectAwardStatus.PendingApproval)
    {
        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="ms-auto d-flex gap-1" data-confirm="Hủy tờ trình này?">
            <input name="reason" class="form-control form-control-sm" placeholder="Lý do hủy" /><button class="btn btn-sm btn-outline-danger text-nowrap">Hủy tờ trình</button>
        </form>
    }
</div>

@if (problems.Count > 0 && buyer)
{
    <div class="alert alert-warning py-2"><b>Cần hoàn thiện trước khi trình:</b><ul class="mb-0">@foreach (var p in problems) { <li>@p</li> }</ul></div>
}
@if (split != null)
{
    <div class="alert alert-danger py-2"><b>Cảnh báo chia nhỏ gói:</b> @split</div>
}

@if (canDecide)
{
    <div class="card mb-3 border-warning"><div class="card-body">
        <div class="fw-semibold mb-2">Phê duyệt chỉ định thầu – @Model.Vendor?.Name · @Model.NegotiatedGrandTotal.ToMoney() đ (gồm VAT)
            @if (Model.NegotiatedTotal > max) { <span class="badge bg-danger ms-1">Vượt hạn mức @max.ToShortMoney() (khẩn cấp)</span> }</div>
        <form asp-action="Decide" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
            <input name="comment" class="form-control" placeholder="Ý kiến (bắt buộc khi trả lại)" />
            <button name="approve" value="true" class="btn btn-success text-nowrap">Duyệt chỉ định</button>
            <button name="approve" value="false" class="btn btn-outline-danger text-nowrap">Trả lại</button>
        </form>
    </div></div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3"><div class="card-body">
            <h5>@Model.Title</h5>
            <dl class="row small mb-0 info">
                <dt class="col-sm-3">Từ đề nghị</dt><dd class="col-sm-9"><a asp-controller="PurchaseRequests" asp-action="Details" asp-route-id="@Model.PurchaseRequestId">@Model.PurchaseRequest?.Number</a> – @Model.PurchaseRequest?.Department · dự toán @Model.PurchaseRequest?.EstimatedTotal.ToMoney() đ</dd>
                <dt class="col-sm-3">NCC được chỉ định</dt><dd class="col-sm-9"><a asp-controller="Vendors" asp-action="Details" asp-route-id="@Model.VendorId" class="fw-semibold">@Model.Vendor?.Name</a> <span class="stars">@Model.Vendor?.Rating.Stars()</span></dd>
                <dt class="col-sm-3">Căn cứ</dt><dd class="col-sm-9"><b>@Model.Reason.GetDisplayName()</b></dd>
                <dt class="col-sm-3">Thuyết minh</dt><dd class="col-sm-9 pre">@Model.Justification</dd>
                <dt class="col-sm-3">Thương thảo</dt><dd class="col-sm-9">@Model.NegotiationDate.ToDate()@if (!string.IsNullOrEmpty(Model.NegotiationNote)) { <div class="pre">@Model.NegotiationNote</div> }</dd>
                <dt class="col-sm-3">Giao / bảo hành / TT</dt><dd class="col-sm-9">@(Model.LeadTimeDays.HasValue ? Model.LeadTimeDays + " ngày" : "—") · @Model.Warranty · @Model.PaymentTerms</dd>
                <dt class="col-sm-3">Người lập</dt><dd class="col-sm-9">@Model.Buyer?.FullName</dd>
            </dl>
        </div></div>
        <div class="card mb-3"><div class="card-body p-0"><table class="table mb-0">
            <thead><tr><th>#</th><th>Hàng hóa / dịch vụ</th><th>ĐVT</th><th class="money">SL</th><th class="money">Dự toán</th><th class="money">NCC chào</th><th class="money">Thương thảo</th><th class="money">Thành tiền</th></tr></thead>
            <tbody>
            @foreach (var l in Model.Lines)
            {
                <tr><td>@l.SortOrder</td><td>@l.Description</td><td>@l.Unit</td><td class="money">@l.Quantity.ToQty()</td>
                    <td class="money">@l.EstimatedPrice.ToMoney()</td><td class="money">@l.ProposedPrice.ToMoney()</td>
                    <td class="money fw-semibold">@l.NegotiatedPrice.ToMoney()</td><td class="money">@Math.Round(l.Quantity * l.NegotiatedPrice, 0).ToMoney()</td></tr>
            }
            </tbody>
            <tfoot>
                <tr><td colspan="7" class="text-end">Giá NCC chào (trước VAT)</td><td class="money">@Model.ProposedTotal.ToMoney()</td></tr>
                <tr class="fw-bold"><td colspan="7" class="text-end">Sau thương thảo (trước VAT) <span class="text-success fw-normal">– giảm @Model.SavingPercent.ToString("0.#")%</span></td>
                    <td class="money @(Model.NegotiatedTotal > max ? "text-danger" : "")">@Model.NegotiatedTotal.ToMoney()</td></tr>
                <tr><td colspan="7" class="text-end">Tổng gồm VAT @Model.VatPercent.ToString("0.##")%</td><td class="money">@Model.NegotiatedGrandTotal.ToMoney()</td></tr>
            </tfoot>
        </table></div></div>
        <partial name="_Attachments" model="attachments" />
    </div>
    <div class="col-lg-4"><div class="card"><div class="card-header">Nhật ký</div><div class="card-body"><partial name="_History" model="history" />@await Component.InvokeAsync("Signatures", new { type = DocType.DirectAward, id = Model.Id })</div></div></div>
</div>

@model Vendor
@{
    ViewData["Title"] = Model.Name;
    var orders = (List<PurchaseOrder>)ViewBag.Orders;
    var evals = (List<VendorEvaluation>)ViewBag.Evaluations;
    var rfqs = (List<RfqVendor>)ViewBag.Rfqs;
    var spend = orders.Where(o => o.Status >= PoStatus.Approved && o.Status != PoStatus.Cancelled).Sum(o => o.SubTotal);
    var winRate = rfqs.Count(r => r.Responded) == 0 ? 0 : rfqs.Count(r => r.Rfq?.AwardedVendorId == Model.Id) * 100 / rfqs.Count(r => r.Responded);
}
@if (User.IsPurchasing())
{
    <div class="toolbar">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">@L["Sửa"]</a>
        <form asp-action="SetStatus" asp-route-id="@Model.Id" method="post" class="d-flex gap-1 ms-auto">
            <select name="status" class="form-select form-select-sm" style="width:180px" asp-items="Html.GetEnumSelectList<VendorStatus>()"></select>
            <input name="note" class="form-control form-control-sm" placeholder="@L["Ghi chú thẩm định / lý do"]" style="width:260px" />
            <button class="btn btn-sm btn-primary text-nowrap">@L["Cập nhật trạng thái"]</button>
        </form>
    </div>
}
<div class="row g-3">
    <div class="col-lg-4">
        <div class="card"><div class="card-body">
            <h5 class="mb-0">@Model.Name</h5>
            <div class="text-muted mb-2">@Model.Code · MST @Model.TaxCode</div>
            <partial name="_Badge" model="Model.Status" /> <span class="stars ms-2">@Model.Rating.Stars()</span>
            <div class="row text-center mt-3">
                <div class="col"><div class="small text-muted">@L["Đã mua"]</div><div class="fw-bold">@spend.ToShortMoney()</div></div>
                <div class="col"><div class="small text-muted">@L["Số PO"]</div><div class="fw-bold">@orders.Count</div></div>
                <div class="col"><div class="small text-muted">@L["Tỷ lệ trúng RFQ"]</div><div class="fw-bold">@winRate%</div></div>
            </div>
            <hr />
            <dl class="row small mb-0 info">
                <dt class="col-5">@L["Nhóm hàng"]</dt><dd class="col-7">@string.Join(", ", Model.Categories.Select(c => c.Category?.Name))</dd>
                <dt class="col-5">@L["Địa chỉ"]</dt><dd class="col-7">@Model.Address</dd>
                <dt class="col-5">@L["Điện thoại"]</dt><dd class="col-7">@Model.Phone</dd>
                <dt class="col-5">Email</dt><dd class="col-7">@Model.Email</dd>
                <dt class="col-5">@L["Người liên hệ"]</dt><dd class="col-7">@Model.ContactPerson – @Model.ContactPhone</dd>
                <dt class="col-5">@L["Tài khoản"]</dt><dd class="col-7">@Model.BankAccount – @Model.BankName</dd>
                <dt class="col-5">@L["Thanh toán"]</dt><dd class="col-7">@Model.PaymentTerms</dd>
                @if (!string.IsNullOrEmpty(Model.BusinessSector)) { <dt class="col-5">@L["Lĩnh vực kinh doanh"]</dt><dd class="col-7">@Model.BusinessSector</dd> }
            </dl>
            @if (!string.IsNullOrEmpty(Model.Note)) { <hr /><div class="small pre">@Model.Note</div> }
        </div></div>
    </div>
    <div class="col-lg-8">
        <div class="card mb-3"><div class="card-header">@L["Đơn mua hàng"]</div><div class="card-body p-0"><table class="table mb-0">
            <thead><tr><th>@L["Số PO"]</th><th>@L["Ngày đặt"]</th><th>@L["Ngày giao"]</th><th class="money">@L["Tổng giá trị"]</th><th>@L["Trạng thái"]</th></tr></thead>
            <tbody>
            @foreach (var o in orders) { <tr><td><a asp-controller="PurchaseOrders" asp-action="Details" asp-route-id="@o.Id">@o.Number</a></td><td>@o.OrderDate.ToDate()</td><td>@o.DeliveryDate.ToDate()</td><td class="money">@o.Total.ToMoney()</td><td><partial name="_Badge" model="o.Status" /></td></tr> }
            @if (!orders.Any()) { <tr><td colspan="5" class="text-muted p-3">@L["Chưa có đơn hàng."]</td></tr> }
            </tbody>
        </table></div></div>
        <div class="card mb-3"><div class="card-header">@L["Lịch sử đánh giá"]</div><div class="card-body p-0"><table class="table mb-0">
            <thead><tr><th>@L["Ngày"]</th><th>PO</th><th class="text-center">@L["Chất lượng"]</th><th class="text-center">@L["Tiến độ"]</th><th class="text-center">@L["Giá"]</th><th class="text-center">@L["Dịch vụ"]</th><th>@L["Nhận xét"]</th></tr></thead>
            <tbody>
            @foreach (var e in evals) { <tr><td>@e.CreatedAt.ToDate()</td><td>@e.PurchaseOrder?.Number</td><td class="text-center">@e.Quality</td><td class="text-center">@e.Delivery</td><td class="text-center">@e.Price</td><td class="text-center">@e.Service</td><td class="small">@e.Comment<br /><span class="text-muted">@e.Evaluator?.FullName</span></td></tr> }
            @if (!evals.Any()) { <tr><td colspan="7" class="text-muted p-3">@L["Chưa có đánh giá."]</td></tr> }
            </tbody>
        </table></div></div>
        <div class="card"><div class="card-header">@L["Tham gia báo giá"]</div><div class="card-body p-0"><table class="table mb-0">
            <thead><tr><th>RFQ</th><th>@L["Đã báo giá"]</th><th class="money">@L["Tổng báo giá"]</th><th>@L["Kết quả"]</th></tr></thead>
            <tbody>
            @foreach (var r in rfqs) { <tr><td><a asp-controller="Rfqs" asp-action="Details" asp-route-id="@r.RfqId">@r.Rfq?.Number</a> – @r.Rfq?.Title</td><td>@(r.Responded ? L["Có"] : L["Chưa"])</td><td class="money">@(r.Responded ? r.TotalAmount.ToMoney() : "")</td>
                <td>@(r.Rfq?.AwardedVendorId == Model.Id ? Html.Raw("<span class='badge bg-success'>" + L["Trúng"] + "</span>") : r.Rfq?.Status == RfqStatus.Awarded ? Html.Raw("<span class='badge bg-secondary'>" + L["Không trúng"] + "</span>") : Html.Raw(""))</td></tr> }
            </tbody>
        </table></div></div>
    </div>
</div>

@{ var portalUsers = (List<VendorUser>)ViewBag.PortalUsers; var vdocs = (List<VendorDocument>)ViewBag.Documents; var canManage = User.IsPurchasing(); }
<div class="row g-3 mt-1">
    <div class="col-lg-5">
        <div class="card"><div class="card-header">@L["Tài khoản cổng NCC ("]@portalUsers.Count)</div><div class="card-body p-0"><table class="table table-sm mb-0 small align-middle">
            @foreach (var u in portalUsers)
            {
                <tr><td>@u.FullName<div class="text-muted">@u.Email · @u.Position</div></td>
                    <td>@if (!u.IsApproved) { <span class="badge bg-warning text-dark">@L["Chờ xác nhận"]</span> } else if (!u.IsActive) { <span class="badge bg-secondary">@L["Đã khóa"]</span> } else if (LoginGuard.IsLocked(u.LockoutEnd)) { <span class="badge bg-danger">@L["Tạm khóa"]</span> } else { <span class="badge bg-success-subtle text-success">@L["Hoạt động"]</span> }
                        <div class="text-muted">@(u.LastLoginAt == null ? L["chưa đăng nhập"] : L["đăng nhập "] + u.LastLoginAt.ToDateTime())</div></td>
                    <td class="text-end text-nowrap">@if (canManage)
                    {
                        <form asp-action="PortalUser" asp-route-id="@Model.Id" method="post" class="d-inline"><input type="hidden" name="userId" value="@u.Id" />
                            @if (!u.IsApproved) { <button name="op" value="approve" class="btn btn-sm btn-success" data-confirm="@L["Xác nhận {0} thuộc {1}?", u.Email, Model.Name]">@L["Xác nhận"]</button> }
                            @if (u.IsActive) { <button name="op" value="lock" class="btn btn-sm btn-link text-danger">@L["Khóa"]</button> } else { <button name="op" value="unlock" class="btn btn-sm btn-link">@L["Mở khóa"]</button> }
                        </form>
                    }</td></tr>
            }
            @if (!portalUsers.Any()) { <tr><td class="text-muted p-3">@L["NCC chưa có tài khoản trên cổng."]</td></tr> }
        </table></div></div>
    </div>
    <div class="col-lg-7">
        <div class="card"><div class="card-header">@L["Hồ sơ pháp lý & năng lực ("]@vdocs.Count)</div><div class="card-body p-0"><table class="table table-sm mb-0 small align-middle">
            <thead><tr><th>@L["Loại / file"]</th><th>@L["Số hiệu"]</th><th>@L["Hiệu lực đến"]</th><th>@L["Trạng thái"]</th><th></th></tr></thead><tbody>
            @foreach (var d in vdocs)
            {
                <tr class="@(d.ExpiryDate < DateTime.Today ? "table-danger" : d.ExpiryDate < DateTime.Today.AddDays(30) ? "table-warning" : "")">
                    <td><a asp-action="Document" asp-route-id="@Model.Id" asp-route-docId="@d.Id">@d.Type.GetDisplayName()</a><div class="text-muted">@d.FileName · @d.UploadedAt.ToDate()</div></td>
                    <td>@d.Number<div class="text-muted">@(d.IssueDate == null ? "" : L["cấp "] + d.IssueDate.ToDate())</div></td><td>@d.ExpiryDate.ToDate()</td>
                    <td>@d.Status.GetDisplayName()<div class="text-muted">@d.Note @(d.VerifiedBy == null ? "" : "· " + d.VerifiedBy.FullName)</div></td>
                    <td class="text-end">@if (canManage && d.Status == VendorDocumentStatus.Pending)
                    {
                        <form asp-action="VerifyDocument" asp-route-id="@Model.Id" method="post" class="d-flex gap-1"><input type="hidden" name="docId" value="@d.Id" />
                            <input name="note" class="form-control form-control-sm" placeholder="@L["Ghi chú"]" style="width:110px" />
                            <button name="accept" value="true" class="btn btn-sm btn-success">@L["Đạt"]</button><button name="accept" value="false" class="btn btn-sm btn-outline-danger">@L["Không"]</button></form>
                    }</td></tr>
            }
            @if (!vdocs.Any()) { <tr><td colspan="5" class="text-muted p-3">@L["Chưa có hồ sơ tải lên qua cổng."]</td></tr> }
            </tbody></table></div></div>
    </div>
</div>

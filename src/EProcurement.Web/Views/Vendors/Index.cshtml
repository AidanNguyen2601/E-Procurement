@model List<Vendor>
@{
    ViewData["Title"] = "Nhà cung cấp";
    var status = ViewBag.Status as VendorStatus?;
    var statusItems = Html.GetEnumSelectList<VendorStatus>().ToList();
    foreach (var i in statusItems) i.Selected = status.HasValue && i.Value == ((int)status.Value).ToString();
    var cats = (List<Category>)ViewBag.Categories;
    int? catId = ViewBag.CategoryId;
    var spend = (Dictionary<int, decimal>)ViewBag.Spend;
}
<form method="get" class="toolbar">
    <div><label class="form-label small mb-1">@L["Tìm kiếm"]</label><input name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="@L["Tên, mã, MST"]" /></div>
    <div><label class="form-label small mb-1">@L["Trạng thái"]</label><select name="status" class="form-select" asp-items="statusItems"><option value="">@L["-- Tất cả --"]</option></select></div>
    <div><label class="form-label small mb-1">@L["Nhóm hàng"]</label><select name="categoryId" class="form-select"><option value="">@L["-- Tất cả --"]</option>@foreach (var c in cats) { <option value="@c.Id" selected="@(c.Id == catId)">@c.Name</option> }</select></div>
    <button class="btn btn-outline-primary">@L["Lọc"]</button>
    @if (User.IsPurchasing()) { <a class="btn btn-primary ms-auto" asp-action="Create">@L["+ Đăng ký NCC"]</a> }
</form>
<div class="card"><div class="card-body p-0"><table class="table table-hover mb-0">
    <thead><tr><th>@L["Mã"]</th><th>@L["Nhà cung cấp"]</th><th>MST</th><th>@L["Nhóm hàng"]</th><th>@L["Liên hệ"]</th><th>@L["Đánh giá"]</th><th class="money">@L["Giá trị đã mua"]</th><th>@L["Trạng thái"]</th></tr></thead>
    <tbody>
    @foreach (var v in Model)
    {
        <tr>
            <td>@v.Code</td>
            <td><a asp-action="Details" asp-route-id="@v.Id" class="fw-semibold">@v.Name</a>@if (!string.IsNullOrEmpty(v.BusinessSector)) { <div class="small text-muted">@v.BusinessSector</div> }</td>
            <td>@v.TaxCode</td>
            <td class="small">@string.Join(", ", v.Categories.Select(c => c.Category?.Name))</td>
            <td class="small">@v.ContactPerson<br />@v.ContactPhone</td>
            <td><span class="stars">@v.Rating.Stars()</span></td>
            <td class="money">@(spend.TryGetValue(v.Id, out var s) ? s.ToMoney() : "")</td>
            <td><partial name="_Badge" model="v.Status" /></td>
        </tr>
    }
    </tbody>
</table></div></div>

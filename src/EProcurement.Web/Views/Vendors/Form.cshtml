@model Vendor
@{
    ViewData["Title"] = Model.Id == 0 ? "Đăng ký nhà cung cấp" : $"Sửa: {Model.Name}";
    var all = (List<Category>)ViewBag.AllCategories;
    var selected = (List<int>)ViewBag.Selected;
}
<div class="card" style="max-width:1000px"><div class="card-body">
<form asp-action="Save" method="post">
    <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="CreatedAt" /><input type="hidden" asp-for="Rating" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-2"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" /><span asp-validation-for="Code" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
        <div class="col-md-2"><label asp-for="TaxCode" class="form-label"></label><input asp-for="TaxCode" class="form-control" /><span asp-validation-for="TaxCode" class="text-danger small"></span></div>
        <div class="col-md-2"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<VendorStatus>()"></select></div>
        <div class="col-md-6"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div>
        <div class="col-md-4"><label asp-for="ContactPerson" class="form-label"></label><input asp-for="ContactPerson" class="form-control" /></div>
        <div class="col-md-2"><label asp-for="ContactPhone" class="form-label"></label><input asp-for="ContactPhone" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="BankAccount" class="form-label"></label><input asp-for="BankAccount" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="BankName" class="form-label"></label><input asp-for="BankName" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="PaymentTerms" class="form-label"></label><input asp-for="PaymentTerms" class="form-control" /></div>
        <div class="col-md-6"><label class="form-label">Nhóm hàng cung cấp</label>
            <div class="d-flex flex-wrap gap-3">@foreach (var c in all) { <div class="form-check"><input class="form-check-input" type="checkbox" name="categoryIds" value="@c.Id" id="c@(c.Id)" checked="@selected.Contains(c.Id)" /><label class="form-check-label" for="c@(c.Id)">@c.Name</label></div> }</div></div>
        <div class="col-12"><label asp-for="Note" class="form-label"></label><textarea asp-for="Note" class="form-control" rows="2"></textarea></div>
    </div>
    <div class="mt-4"><button class="btn btn-primary">Lưu</button> <a asp-action="Index" class="btn btn-light">Hủy</a></div>
</form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_AuthLayout";
}
<div class="auth-card">
    <h3 class="mb-1 fw-bold">E-Procurement</h3>
    <p class="text-muted mb-4">Đăng nhập để tiếp tục</p>
    <form asp-action="Login" method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <div class="mb-3">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control" autofocus />
            <span asp-validation-for="Username" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label"></label>
        </div>
        <button class="btn btn-primary w-100">Đăng nhập</button>
    </form>
    <div class="mt-3 small"><a asp-controller="PortalAccount" asp-action="Login">Nhà cung cấp? Đăng nhập cổng nhà cung cấp →</a></div>
    <div class="mt-4 small text-muted">
        Tài khoản demo: <b>admin</b> · <b>requester</b> · <b>approver</b> · <b>director</b> · <b>buyer</b> — mật khẩu <b>Abc@123</b>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

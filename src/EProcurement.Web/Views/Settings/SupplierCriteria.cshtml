@model SupplierCriteriaSettings
@{ var levels = (List<GradeLevel>)ViewBag.Levels; }
<div class="row g-3">
<div class="col-lg-8">
<form method="post" asp-action="SupplierCriteria" class="card">
    <div class="card-header">Tiêu chí đánh giá định kỳ (thang điểm 1–5)</div>
    <div class="table-responsive"><table class="table align-middle mb-0">
        <thead><tr><th style="width:28%">Tên tiêu chí</th><th style="width:14%">Trọng số</th><th>Hướng dẫn chấm điểm</th></tr></thead>
        <tbody>
        @for (var i = 0; i < 4; i++)
        {
            var k = SupplierCriteriaSettings.Defaults()[i].Key;
            var it = Model.Of(k);
            <tr>
                <td><input type="hidden" name="Items[@i].Key" value="@k" /><input name="Items[@i].Label" value="@it.Label" maxlength="60" class="form-control form-control-sm" required /></td>
                <td><div class="input-group input-group-sm"><input name="Items[@i].Weight" type="number" min="0" max="100" value="@it.Weight" class="form-control w-input" /><span class="input-group-text">%</span></div></td>
                <td><input name="Items[@i].Guide" value="@it.Guide" maxlength="300" class="form-control form-control-sm" /></td>
            </tr>
        }
        </tbody>
        <tfoot><tr><td class="text-end">Tổng</td><td><b id="w-sum"></b></td><td class="small text-muted">Trọng số được quy về tỷ lệ – tổng không bắt buộc 100.</td></tr></tfoot>
    </table></div>
    <div class="card-footer"><button class="btn btn-primary">Lưu</button></div>
</form>
</div>
<div class="col-lg-4">
    <div class="card"><div class="card-header">Xếp loại theo điểm tổng hợp</div><ul class="list-group list-group-flush small">
        @foreach (var l in levels.OrderByDescending(l => l.Min)) { <li class="list-group-item d-flex justify-content-between"><span><b>@l.Code</b> – @l.Label</span><span>≥ @l.Min.ToString("0.##")</span></li> }
    </ul><div class="card-body small text-muted">Ngưỡng xếp loại chỉnh trong <a asp-controller="Catalogs" asp-action="Index" asp-route-type="@CatalogType.SupplierGrade">Danh mục → Xếp loại NCC</a>.
        Điểm tổng hợp = trung bình có trọng số các tiêu chí trên phiếu đánh giá; NCC chưa có phiếu dùng tỷ lệ giao đúng hạn và hàng đạt.</div></div>
</div>
</div>
<script>
    (function () { const s = () => document.getElementById('w-sum').textContent = [...document.querySelectorAll('.w-input')].reduce((a, i) => a + (+i.value || 0), 0) + '%';
        document.querySelectorAll('.w-input').forEach(i => i.addEventListener('input', s)); s(); })();
</script>

@model ProcurementPlan
@{ var history = (List<ApprovalHistory>)ViewBag.History; var budget = (decimal?)ViewBag.Budget; var mine = Model.Department == User.GetDepartment(); }
<div class="row g-3">
<div class="col-lg-8">
    <div class="card mb-3"><div class="card-body d-flex flex-wrap justify-content-between gap-2">
        <div><span class="badge @(Model.Status switch { PlanStatus.Approved => "bg-success", PlanStatus.Submitted => "bg-warning text-dark", PlanStatus.Returned => "bg-danger", _ => "bg-light text-dark border" })">@Model.Status.GetDisplayName()</span>
            <span class="small text-muted ms-2">@L["Lập:"] @Model.CreatedBy?.FullName @Model.CreatedAt.ToDate()@(Model.ApprovedBy != null ? L[" · Duyệt: {0} {1:dd/MM/yyyy}", Model.ApprovedBy.FullName, Model.ApprovedAt] : "")</span>
            @if (!string.IsNullOrEmpty(Model.Note)) { <div class="small mt-1">@Model.Note</div> }
            @if (!string.IsNullOrEmpty(Model.DecisionNote)) { <div class="small mt-1 text-muted">@L["Ý kiến Giám đốc:"] @Model.DecisionNote</div> }</div>
        <div class="text-end"><div class="small text-muted">@L["Giá trị kế hoạch"]</div><div class="fs-5 fw-semibold">@Model.Total.ToMoney() đ</div>
            @if (budget.HasValue) { <div class="small @(Model.Total > budget ? "text-danger" : "text-muted")">@L["Ngân sách năm"] @Model.Year: @budget.Value.ToMoney() đ@(Model.Total > budget ? " – " + L["kế hoạch vượt ngân sách"] : "")</div> }</div>
    </div></div>
    <div class="card mb-3"><div class="card-body p-0"><table class="table table-sm mb-0 align-middle">
        <thead><tr><th>#</th><th>@L["Hàng hóa / dịch vụ"]</th><th>@L["Nhóm"]</th><th>@L["ĐVT"]</th><th class="money">SL</th><th class="money">@L["Đơn giá"]</th><th class="money">@L["Thành tiền"]</th><th>@L["Quý"]</th><th>@L["Đã gom"]</th></tr></thead><tbody>
        @{ var n = 1; }
        @foreach (var l in Model.Lines)
        {
            <tr><td>@(n++)</td><td>@l.Description</td><td class="small">@l.Item?.Category?.Name</td><td>@l.Unit</td><td class="money">@l.Quantity.ToQty()</td><td class="money">@l.EstimatedPrice.ToMoney()</td>
                <td class="money">@((l.Quantity * l.EstimatedPrice).ToMoney())</td><td>Q@(l.Quarter)</td>
                <td class="small">@if (l.PurchaseRequest != null) { <a asp-controller="PurchaseRequests" asp-action="Details" asp-route-id="@l.PurchaseRequestId">@l.PurchaseRequest.Number</a> }</td></tr>
        }
    </tbody></table></div></div>
    @if (Model.Status == PlanStatus.Submitted && (User.IsInRole(AppRoles.Director) || User.IsAdmin()))
    {
        <div class="card border-warning"><div class="card-body">
            <form asp-action="Decide" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                <input name="comment" class="form-control form-control-sm" placeholder="@L["Ý kiến (bắt buộc khi trả lại)"]" />
                <button name="approve" value="true" class="btn btn-sm btn-success text-nowrap">@L["Duyệt kế hoạch"]</button>
                <button name="approve" value="false" class="btn btn-sm btn-outline-danger text-nowrap">@L["Trả lại"]</button>
            </form></div></div>
    }
    @if (mine && Model.Status is PlanStatus.Draft or PlanStatus.Returned) { <a asp-action="Edit" asp-route-year="@Model.Year" class="btn btn-sm btn-outline-primary">@L["Sửa kế hoạch"]</a> }
</div>
<div class="col-lg-4"><div class="card"><div class="card-header">@L["Nhật ký"]</div><div class="card-body"><partial name="_History" model="history" />@await Component.InvokeAsync("Signatures", new { type = DocType.Plan, id = Model.Id })</div></div></div>
</div>

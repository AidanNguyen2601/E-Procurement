@model EProcurement.Web.Controllers.PortalLoginModel
@{ ViewData["Title"] = "Đăng nhập cổng nhà cung cấp"; Layout = "_AuthLayout"; }
<div class="auth-card">
    <h3 class="mb-1 fw-bold">@L["Cổng nhà cung cấp"]</h3>
    <p class="text-muted mb-4">@L["Báo giá, dự thầu online và theo dõi đơn hàng"]</p>
    <form asp-action="Login" method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autofocus /><span asp-validation-for="Email" class="text-danger small"></span></div>
        <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" /><span asp-validation-for="Password" class="text-danger small"></span></div>
        <button class="btn btn-primary w-100">@L["Đăng nhập"]</button>
    </form>
    <div class="mt-3 small">@L["Chưa có tài khoản?"] <a asp-action="Register">@L["Đăng ký nhà cung cấp"]</a></div>
    <div class="mt-2 small"><a asp-controller="PortalPublic" asp-action="Notices">@L["Thông báo mời thầu"]</a> · <a asp-controller="PortalPublic" asp-action="Guide">@L["Hướng dẫn nộp thầu"]</a> · <a asp-controller="Account" asp-action="Login">@L["Đăng nhập nội bộ"]</a></div>
</div>

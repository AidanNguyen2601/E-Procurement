@model RfqCreateViewModel
@{
    ViewData["Title"] = "Tạo yêu cầu báo giá";
    ViewData["PriceLabel"] = null;
    ViewData["ItemsJson"] = ViewBag.ItemsJson;
}
<form asp-action="Create" method="post">
    <input type="hidden" asp-for="PurchaseRequestId" /><input type="hidden" asp-for="PackageId" />
    <partial name="_PackageBanner" model="ViewBag.Package as ProcurementPackage" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="card mb-3"><div class="card-body row g-3">
        @if (Model.PurchaseRequest != null)
        {
            <div class="col-12"><div class="alert alert-info mb-0 py-2">@L["Lập từ đề nghị"] <b>@Model.PurchaseRequest.Number</b> – @Model.PurchaseRequest.Title @L["(dự toán"] @Model.PurchaseRequest.EstimatedTotal.ToMoney() @L["đ)"]</div></div>
        }
        <div class="col-md-8"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger small"></span></div>
        <div class="col-md-4"><label asp-for="Deadline" class="form-label"></label><input asp-for="Deadline" class="form-control" /></div>
        <div class="col-12"><label asp-for="Requirements" class="form-label"></label><textarea asp-for="Requirements" class="form-control" rows="2"></textarea></div>
        <div class="col-md-6"><label asp-for="EvaluationMethod" class="form-label"></label>
            <select asp-for="EvaluationMethod" class="form-select" asp-items="Html.GetEnumSelectList<EvaluationMethod>()" id="evalMethod"></select>
            <div class="small text-muted">@L["Báo giá không chào đủ các dòng hoặc không đạt kỹ thuật bị loại trước khi xét giá. Giá so sánh là giá sau VAT."]</div></div>
        <div class="col-md-2 weights"><label asp-for="PriceWeight" class="form-label"></label><input asp-for="PriceWeight" class="form-control" /></div>
        <div class="col-md-2 weights"><label asp-for="TechnicalWeight" class="form-label"></label><input asp-for="TechnicalWeight" class="form-control" /></div>
        <div class="col-md-2 weights"><label asp-for="DeliveryWeight" class="form-label"></label><input asp-for="DeliveryWeight" class="form-control" /></div>
    </div></div>
    <partial name="_LineEditor" model="Model.Lines" />
    <div class="card mb-3"><div class="card-header">@L["Mời nhà cung cấp"] <span class="small fw-normal text-muted">@L["(chỉ NCC đã phê duyệt; gợi ý theo nhóm hàng, sắp theo điểm đánh giá)"]</span></div>
        <div class="card-body row">
            <div class="col-md-6">
                <div class="small fw-semibold mb-1">@L["Phù hợp nhóm hàng"]</div>
                @foreach (var v in Model.SuggestedVendors)
                {
                    <div class="form-check"><input class="form-check-input" type="checkbox" name="VendorIds" value="@v.Id" id="v@(v.Id)" checked="@Model.VendorIds.Contains(v.Id)" />
                        <label class="form-check-label" for="v@(v.Id)">@v.Name <span class="stars small">@v.Rating.Stars()</span>@if ((ViewBag.Prequalified as HashSet<int>)?.Contains(v.Id) == true) { <span class="badge bg-success-subtle text-success">@L["đạt sơ tuyển"]</span> }</label></div>
                }
                @if (!Model.SuggestedVendors.Any()) { <div class="text-muted small">@L["Không có NCC phù hợp nhóm hàng."]</div> }
            </div>
            <div class="col-md-6">
                <div class="small fw-semibold mb-1">@L["NCC khác"]</div>
                @foreach (var v in Model.OtherVendors)
                {
                    <div class="form-check"><input class="form-check-input" type="checkbox" name="VendorIds" value="@v.Id" id="v@(v.Id)" checked="@Model.VendorIds.Contains(v.Id)" />
                        <label class="form-check-label" for="v@(v.Id)">@v.Name <span class="stars small">@v.Rating.Stars()</span></label></div>
                }
            </div>
        </div>
    </div>
    <button class="btn btn-outline-primary" name="publish" value="false">@L["Lưu nháp"]</button>
    <button class="btn btn-primary" name="publish" value="true">@L["Lưu & phát hành"]</button>
    <a asp-action="Index" class="btn btn-light">@L["Hủy"]</a>
</form>
@section Scripts {
<script>
    // Chỉ hiện trọng số khi chấm điểm có trọng số
    (function () {
        const sel = document.getElementById('evalMethod');
        const toggle = () => document.querySelectorAll('.weights').forEach(e => e.style.display = sel.value === '2' ? '' : 'none');
        sel.addEventListener('change', toggle); toggle();
    })();
</script>
}

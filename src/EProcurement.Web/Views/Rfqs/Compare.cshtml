@model ComparisonViewModel
@{
    var r = Model.Rfq;
    ViewData["Title"] = $"So sánh & xếp hạng {r.Number}";
    var weighted = r.EvaluationMethod == EvaluationMethod.WeightedScore;
    var evaluated = RfqEvaluation.AllTechnicallyEvaluated(r);
    var canAward = User.IsPurchasing() && r.Status == RfqStatus.Opened && evaluated;
    var validCount = Model.Scores.Count(s => s.Valid);
}
@if (!Model.Scores.Any())
{
    <div class="alert alert-warning">Không có báo giá nào.</div>
}
else
{
    <div class="small text-muted mb-2">
        Phương pháp: <b>@r.EvaluationMethod.GetDisplayName()</b>
        @if (weighted) { <span>(giá @r.PriceWeight% · kỹ thuật @r.TechnicalWeight% · tiến độ @r.DeliveryWeight%)</span> }.
        Ô xanh: đơn giá thấp nhất từng dòng (trong báo giá hợp lệ). Khung xanh: NCC xếp hạng 1. Dự toán tham chiếu: <b>@Model.ReferenceTotal.ToMoney() đ</b>.
    </div>
    @if (!evaluated)
    {
        <div class="alert alert-warning py-2">Chưa đánh giá kỹ thuật đủ các báo giá – xếp hạng chưa đầy đủ.
            @if (User.IsPurchasing() && r.Status == RfqStatus.Opened) { <a asp-action="Evaluate" asp-route-id="@r.Id" class="alert-link">Đánh giá kỹ thuật</a> }</div>
    }
    else if (validCount < Model.MinValidQuotes && r.Status == RfqStatus.Opened)
    {
        <div class="alert alert-warning py-2">Chỉ có <b>@validCount/@Model.MinValidQuotes</b> báo giá hợp lệ – kết quả sẽ phải trình Giám đốc duyệt.</div>
    }
    <div class="card mb-3"><div class="card-body p-0 table-responsive">
    <table class="table table-bordered compare mb-0">
        <thead>
            <tr><th>Hàng hóa / dịch vụ</th><th class="money">SL</th>
                @foreach (var s in Model.Scores)
                {
                    var v = s.Quote;
                    <th class="vendor-head text-center @(s.Rank == 1 ? "winner" : "") @(r.AwardedVendorId == v.VendorId || r.ProposedVendorId == v.VendorId ? "table-success" : "") @(s.Valid ? "" : "text-muted")">
                        @if (s.Rank.HasValue) { <span class="badge bg-primary">Hạng @s.Rank</span> } else { <span class="badge bg-secondary">Loại</span> }<br />
                        @v.Vendor?.Name<br /><span class="stars small fw-normal">@v.Vendor?.Rating.Stars()</span></th>
                }
            </tr>
        </thead>
        <tbody>
        @foreach (var l in r.Lines)
        {
            <tr><td>@l.Description <span class="text-muted small">(@l.Unit)</span></td><td class="money">@l.Quantity.ToQty()</td>
                @foreach (var s in Model.Scores)
                {
                    var q = s.Quote.QuoteLines.FirstOrDefault(x => x.RfqLineId == l.Id);
                    var best = s.Valid && q != null && Model.LowestByLine.TryGetValue(l.Id, out var lo) && q.UnitPrice == lo;
                    <td class="money @(best ? "best" : "") @(s.Rank == 1 ? "winner" : "") @(s.Valid ? "" : "text-muted")">
                        @if (q != null && q.UnitPrice > 0) { @q.UnitPrice.ToMoney()<div class="small text-muted">= @q.Amount.ToMoney()</div> } else { <span class="text-danger">không chào</span> }
                    </td>
                }
            </tr>
        }
        </tbody>
        <tfoot>
            <tr><td colspan="2" class="text-end">Tổng trước VAT</td>@foreach (var s in Model.Scores) { <td class="money">@s.Quote.TotalAmount.ToMoney()</td> }</tr>
            <tr><td colspan="2" class="text-end">VAT</td>@foreach (var s in Model.Scores) { <td class="money">@s.Quote.VatPercent.ToString("0.##")%</td> }</tr>
            <tr class="fw-bold"><td colspan="2" class="text-end">Tổng gồm VAT</td>@foreach (var s in Model.Scores) { <td class="money @(s.Rank == 1 ? "winner best" : "")">@s.Quote.GrandTotal.ToMoney()</td> }</tr>
            <tr><td colspan="2" class="text-end">So với dự toán</td>@foreach (var s in Model.Scores) { var d = Model.ReferenceTotal == 0 ? 0 : (s.Quote.TotalAmount - Model.ReferenceTotal) * 100 / Model.ReferenceTotal; <td class="money @(d <= 0 ? "text-success" : "text-danger")">@(d > 0 ? "+" : "")@d.ToString("0.0")%</td> }</tr>
            <tr><td colspan="2" class="text-end">Thời gian giao</td>@foreach (var s in Model.Scores) { <td class="money">@(s.Quote.LeadTimeDays.HasValue ? s.Quote.LeadTimeDays + " ngày" : "—")</td> }</tr>
            <tr><td colspan="2" class="text-end">Bảo hành</td>@foreach (var s in Model.Scores) { <td class="text-end small">@s.Quote.Warranty</td> }</tr>
            <tr><td colspan="2" class="text-end">Thanh toán</td>@foreach (var s in Model.Scores) { <td class="text-end small">@s.Quote.PaymentTerms</td> }</tr>
            <tr><td colspan="2" class="text-end">Kỹ thuật</td>@foreach (var s in Model.Scores)
                {
                    <td class="text-end small">@if (s.Quote.TechnicalPass == true) { <span class="text-success">Đạt</span> } else if (s.Quote.TechnicalPass == false) { <span class="text-danger">Không đạt</span> } else { <span class="text-warning">Chưa đánh giá</span> }</td>
                }</tr>
            @if (weighted)
            {
                <tr><td colspan="2" class="text-end">Điểm giá / KT / tiến độ</td>@foreach (var s in Model.Scores) { <td class="money small">@(s.Valid ? $"{s.PriceScore:0.#} / {s.TechnicalScore:0.#} / {s.DeliveryScore:0.#}" : "")</td> }</tr>
                <tr class="fw-bold"><td colspan="2" class="text-end">Tổng điểm</td>@foreach (var s in Model.Scores) { <td class="money @(s.Rank == 1 ? "winner best" : "")">@(s.Valid ? s.Total.ToString("0.##") : "")</td> }</tr>
            }
            <tr><td colspan="2" class="text-end">Ghi chú</td>@foreach (var s in Model.Scores) { <td class="small text-danger">@string.Join("; ", s.Issues.Where(i => !s.Valid))</td> }</tr>
            @if (canAward)
            {
                <tr><td colspan="2"></td>@foreach (var s in Model.Scores)
                {
                    <td>
                        @if (s.Valid)
                        {
                            <form asp-action="Award" asp-route-id="@r.Id" method="post" data-confirm="Đề xuất @s.Quote.Vendor?.Name trúng?@(s.Rank != 1 ? " (Không phải hạng 1 – sẽ trình Giám đốc duyệt)" : "")">
                                <input type="hidden" name="vendorId" value="@s.Quote.VendorId" />
                                <input name="reason" class="form-control form-control-sm mb-1" placeholder="Lý do chọn"
                                       value="@(s.Rank == 1 ? weighted ? "Tổng điểm cao nhất, đạt yêu cầu kỹ thuật" : "Giá thấp nhất, đạt yêu cầu kỹ thuật" : "")" />
                                <button class="btn btn-sm @(s.Rank == 1 ? "btn-success" : "btn-outline-success") w-100">Đề xuất NCC này</button>
                            </form>
                        }
                    </td>
                }</tr>
            }
        </tfoot>
    </table>
    </div></div>
}
@{ var pending = r.Vendors.Where(v => !v.Responded).ToList(); }
@if (pending.Any()) { <div class="small text-muted">Không nộp báo giá: @string.Join(", ", pending.Select(v => v.Vendor?.Name))</div> }
<a asp-action="Details" asp-route-id="@r.Id" class="btn btn-light mt-3">← Quay lại RFQ</a>
<a asp-action="Report" asp-route-id="@r.Id" class="btn btn-outline-secondary mt-3" target="_blank">Biên bản đánh giá</a>

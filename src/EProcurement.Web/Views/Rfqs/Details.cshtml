@model Rfq
@{
    ViewData["Title"] = $"{Model.Number} – {Model.Title}";
    var history = (List<ApprovalHistory>)ViewBag.History;
    var po = ViewBag.Po as PurchaseOrder;
    var buyer = User.IsPurchasing();
    var unsealed = RfqEvaluation.IsUnsealed(Model);
    var canOpen = buyer && RfqEvaluation.CanOpen(Model);
    var canDecide = Model.Status == RfqStatus.PendingApproval && (User.IsInRole(AppRoles.Director) || User.IsAdmin());
    var responded = Model.Vendors.Count(v => v.Responded);
    var steps = new (string Name, bool Done, bool Current)[]
    {
        (L["Nháp"], Model.Status != RfqStatus.Draft, Model.Status == RfqStatus.Draft),
        (L["Nhận báo giá"], Model.OpenedAt.HasValue, Model.Status == RfqStatus.Open),
        (L["Mở & đánh giá"], Model.Status is RfqStatus.PendingApproval or RfqStatus.Awarded, Model.Status == RfqStatus.Opened),
        (L["Duyệt kết quả"], Model.Status == RfqStatus.Awarded, Model.Status == RfqStatus.PendingApproval),
        (L["Đã chọn NCC"], false, Model.Status == RfqStatus.Awarded)
    };
}
<div class="card mb-3"><div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div class="flow">
        @for (var i = 0; i < steps.Length; i++)
        {
            <span class="step @(Model.Status == RfqStatus.Cancelled ? "" : steps[i].Done ? "done" : steps[i].Current ? "current" : "")">@steps[i].Name</span>
            @if (i < steps.Length - 1) { <span class="arrow">›</span> }
        }
    </div>
    <partial name="_Badge" model="Model.Status" />
</div></div>

<div class="toolbar">
    @if (buyer && Model.Status == RfqStatus.Draft)
    {
        <form asp-action="Publish" asp-route-id="@Model.Id" method="post"><button class="btn btn-primary">@L["Phát hành RFQ"]</button></form>
    }
    @if (canOpen)
    {
        <form asp-action="OpenQuotes" asp-route-id="@Model.Id" method="post" data-confirm="@L["Mở báo giá? Sau khi mở, giá chào được công khai và không nhập / sửa báo giá được nữa."]">
            <button class="btn btn-primary">@L["Mở báo giá ("]@responded/@Model.Vendors.Count)</button></form>
    }
    @if (buyer && Model.Status == RfqStatus.Opened)
    {
        <a class="btn btn-primary" asp-action="Evaluate" asp-route-id="@Model.Id">@L["Đánh giá kỹ thuật"]</a>
    }
    @if (unsealed)
    {
        <a class="btn btn-outline-primary" asp-action="Compare" asp-route-id="@Model.Id">@L["So sánh & xếp hạng"]</a>
        <a class="btn btn-outline-secondary" asp-action="Report" asp-route-id="@Model.Id" target="_blank">@L["Biên bản đánh giá"]</a>
    }
    @if (po != null) { <a class="btn btn-success" asp-controller="PurchaseOrders" asp-action="Details" asp-route-id="@po.Id">@L["Xem đơn hàng"] @po.Number</a> }
    @if (buyer && Model.Status is RfqStatus.Draft or RfqStatus.Open or RfqStatus.Opened or RfqStatus.PendingApproval)
    {
        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="ms-auto d-flex gap-1" data-confirm="@L["Hủy RFQ này?"]">
            <input name="reason" class="form-control form-control-sm" placeholder="@L["Lý do hủy"]" /><button class="btn btn-sm btn-outline-danger text-nowrap">@L["Hủy RFQ"]</button>
        </form>
    }
</div>

@if (buyer && Model.Status is RfqStatus.Draft or RfqStatus.Open)
{
    <div class="card mb-3"><div class="card-body py-2">
        <form asp-action="ExtendDeadline" asp-route-id="@Model.Id" method="post" class="d-flex flex-wrap gap-2 align-items-center">
            <span class="small text-nowrap">@L["Gia hạn nộp báo giá đến"]</span>
            <input type="date" name="newDeadline" class="form-control form-control-sm" style="width:170px" value="@Model.Deadline.AddDays(3).ToString("yyyy-MM-dd")" />
            <input name="reason" class="form-control form-control-sm flex-grow-1" style="width:auto" placeholder="@L["Lý do gia hạn (bắt buộc)"]" />
            <button class="btn btn-sm btn-outline-primary text-nowrap">@L["Gia hạn"]</button>
        </form>
        @if (Model.Status == RfqStatus.Open && !canOpen)
        {
            <div class="small text-muted mt-1">@L["Mở báo giá được sau khi hết hạn nộp ("]@Model.Deadline.ToDate()@L[") hoặc khi tất cả NCC đã gửi báo giá."]</div>
        }
    </div></div>
}

@if (canDecide)
{
    <div class="card mb-3 border-warning"><div class="card-body">
        <div class="fw-semibold mb-1">@L["Duyệt kết quả lựa chọn NCC – đề xuất"] <span class="text-primary">@Model.ProposedVendor?.Name</span></div>
        <div class="small mb-1">@L["Lý do chọn:"] @Model.AwardReason</div>
        <div class="small text-danger mb-2">@L["Cần duyệt vì:"] @Model.ResultApprovalReason. <a asp-action="Compare" asp-route-id="@Model.Id">@L["Xem bảng xếp hạng"]</a></div>
        <form asp-action="DecideResult" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
            <input name="comment" class="form-control" placeholder="@L["Ý kiến (bắt buộc khi trả lại)"]" />
            <button name="approve" value="true" class="btn btn-success text-nowrap">@L["Duyệt kết quả"]</button>
            <button name="approve" value="false" class="btn btn-outline-danger text-nowrap">@L["Trả lại"]</button>
        </form>
    </div></div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3"><div class="card-body">
            <div class="d-flex justify-content-between"><h5>@Model.Title</h5></div>
            <dl class="row small mb-0 info">
                <dt class="col-sm-3">@L["Từ đề nghị"]</dt><dd class="col-sm-9">@if (Model.PurchaseRequest != null) { <a asp-controller="PurchaseRequests" asp-action="Details" asp-route-id="@Model.PurchaseRequestId">@Model.PurchaseRequest.Number</a> <span>@L["– dự toán"] @Model.PurchaseRequest.EstimatedTotal.ToMoney() đ</span> } else { <span>—</span> }</dd>
                <dt class="col-sm-3">@L["Phát hành / hạn"]</dt><dd class="col-sm-9">@Model.IssueDate.ToDate() → <b class="@(Model.Status == RfqStatus.Open && Model.Deadline < DateTime.Today ? "text-danger" : "")">@Model.Deadline.ToDate()</b>
                    @if (Model.OpenedAt.HasValue) { <span class="text-muted"> @L["· mở báo giá"] @Model.OpenedAt.Value.ToDateTime()</span> }</dd>
                <dt class="col-sm-3">@L["Phương pháp đánh giá"]</dt><dd class="col-sm-9">@Model.EvaluationMethod.GetDisplayName()
                    @if (Model.EvaluationMethod == EvaluationMethod.WeightedScore) { <span class="text-muted">@L["(giá"] @Model.PriceWeight@L["% · kỹ thuật"] @Model.TechnicalWeight@L["% · tiến độ"] @Model.DeliveryWeight%)</span> }</dd>
                <dt class="col-sm-3">@L["Phụ trách"]</dt><dd class="col-sm-9">@Model.Buyer?.FullName</dd>
                <dt class="col-sm-3">@L["Yêu cầu"]</dt><dd class="col-sm-9 pre">@Model.Requirements</dd>
                @if (Model.Status == RfqStatus.PendingApproval && Model.ProposedVendor != null)
                {
                    <dt class="col-sm-3">@L["NCC đề xuất"]</dt><dd class="col-sm-9 fw-semibold">@Model.ProposedVendor.Name <span class="badge bg-warning text-dark">@L["chờ duyệt"]</span></dd>
                    <dt class="col-sm-3">@L["Lý do chọn"]</dt><dd class="col-sm-9">@Model.AwardReason</dd>
                }
                @if (Model.AwardedVendor != null)
                {
                    <dt class="col-sm-3">@L["NCC trúng"]</dt><dd class="col-sm-9 text-success fw-semibold">@Model.AwardedVendor.Name</dd>
                    <dt class="col-sm-3">@L["Lý do chọn"]</dt><dd class="col-sm-9">@Model.AwardReason</dd>
                }
            </dl>
        </div></div>
        <div class="card mb-3"><div class="card-header">@L["Hàng hóa cần báo giá"]</div><div class="card-body p-0"><table class="table mb-0">
            <thead><tr><th>#</th><th>@L["Hàng hóa / dịch vụ"]</th><th>@L["ĐVT"]</th><th class="money">@L["Số lượng"]</th></tr></thead>
            <tbody>@foreach (var l in Model.Lines) { <tr><td>@l.SortOrder</td><td>@l.Description</td><td>@l.Unit</td><td class="money">@l.Quantity.ToQty()</td></tr> }</tbody>
        </table></div></div>
        <div class="card"><div class="card-header d-flex justify-content-between">@L["Nhà cung cấp được mời"]
            @if (!unsealed && Model.Status != RfqStatus.Draft) { <span class="small fw-normal text-muted">@L["🔒 Giá chào niêm phong đến khi mở báo giá"]</span> }</div>
        <div class="card-body p-0"><table class="table mb-0">
            <thead><tr><th>@L["Nhà cung cấp"]</th><th>@L["Báo giá"]</th><th class="money">@L["Tổng (gồm VAT)"]</th><th>@L["Giao hàng"]</th><th>@L["Kỹ thuật"]</th><th></th></tr></thead>
            <tbody>
            @foreach (var v in Model.Vendors.OrderByDescending(v => v.Responded).ThenBy(v => unsealed ? v.GrandTotal : 0).ThenBy(v => v.Vendor?.Name))
            {
                <tr class="@(Model.AwardedVendorId == v.VendorId ? "table-success" : "")">
                    <td><a asp-controller="Vendors" asp-action="Details" asp-route-id="@v.VendorId">@v.Vendor?.Name</a><br /><span class="stars small">@v.Vendor?.Rating.Stars()</span></td>
                    <td>@(v.Responded ? L["Gửi ngày {0}", v.RespondedAt.ToDate()] : unsealed ? L["Không nộp"] : L["Chưa báo giá"])</td>
                    <td class="money">@(v.Responded ? unsealed ? v.GrandTotal.ToMoney() : "🔒" : "")</td>
                    <td>@(unsealed && v.LeadTimeDays.HasValue ? L["{0} ngày", v.LeadTimeDays] : "")</td>
                    <td>@if (v.TechnicalPass == true) { <span class="text-success">Đạt@(v.TechnicalScore.HasValue ? $" ({v.TechnicalScore})" : "")</span> }
                        else if (v.TechnicalPass == false) { <span class="text-danger" title="@v.TechnicalNote">@L["Không đạt"]</span> }</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Invitation" asp-route-id="@Model.Id" asp-route-vendorId="@v.VendorId" target="_blank">@L["Thư mời"]</a>
                        @if (((Dictionary<int, string>)ViewBag.Online).TryGetValue(v.Id, out var onl)) { <span class="badge bg-success-subtle text-success" title="@onl">Online</span><div class="small text-muted">@onl</div> }
                        else if (buyer && Model.Status == RfqStatus.Open) { <a class="btn btn-sm btn-outline-primary" asp-action="EnterQuote" asp-route-rfqVendorId="@v.Id">@(v.Responded ? L["Sửa báo giá"] : L["Nhập báo giá"])</a> }
                        @if (Model.Status == RfqStatus.Awarded && v.Responded) { <a class="btn btn-sm btn-outline-success" asp-action="ResultNotice" asp-route-id="@Model.Id" asp-route-vendorId="@v.VendorId" target="_blank">@L["Thông báo KQ"]</a> }
                    </td>
                </tr>
            }
            </tbody>
        </table></div></div>
    </div>
    <div class="col-lg-4"><div class="card"><div class="card-header">@L["Nhật ký"]</div><div class="card-body"><partial name="_History" model="history" />@await Component.InvokeAsync("Signatures", new { type = DocType.RFQ, id = Model.Id })</div></div></div>
</div>

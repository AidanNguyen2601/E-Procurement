@model StandardReports.Definition[]
@{ ViewData["Title"] = "Báo cáo mua sắm"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="text-muted small">Báo cáo chuẩn – lọc theo kỳ, phòng ban, nhóm hàng, nhà cung cấp; in hoặc xuất Excel.</div>
    <a asp-controller="ReportBuilder" asp-action="Index" class="btn btn-outline-primary">Báo cáo động (tự thiết kế) →</a>
</div>
<div class="row g-3">
    @foreach (var r in Model)
    {
        <div class="col-md-6 col-xl-4">
            <a asp-action="Show" asp-route-id="@r.Key" class="card h-100 text-decoration-none text-reset">
                <div class="card-body">
                    <span class="icon-tile mb-2">@Icon.Svg(r.Icon, 20)</span>
                    <h6 class="mb-1">@r.Title</h6>
                    <div class="small text-muted">@r.Description</div>
                </div>
            </a>
        </div>
    }
</div>

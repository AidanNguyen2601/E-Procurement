@* Model: (int Page, int TotalPages, Func<int,string> Url) *@
@model (int Page, int TotalPages, Func<int, string> Url)
@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Model.Url(Model.Page - 1)">&laquo;</a></li>
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" href="@Model.Url(i)">@i</a></li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@Model.Url(Model.Page + 1)">&raquo;</a></li>
        </ul>
    </nav>
}

@model List<NavItem>
@* Menu ngang (trên / dưới): mỗi nhóm là một danh sách thả xuống; nhóm có nhóm con hiển thị dạng nhiều cột *@
@{
    async Task Item(NavItem l)
    {
        <a class="dropdown-item @(l.Active ? "active" : "")" href="@l.Href" target="@(l.External ? "_blank" : null)">@Icon.Svg(l.Icon, 15)<span>@l.Label</span>@if (l.External) { @Icon.Svg("external", 12, "ms-auto") }</a>
    }
}
<nav class="hnav" aria-label="@L["Menu chính"]">
    <a class="hnav-brand" asp-controller="Home" asp-action="Index">e<span>Procurement</span></a>
    <ul class="hnav-menu">
        @foreach (var m in Model)
        {
            if (!m.IsGroup)
            {
                <li><a class="hnav-link @(m.Active ? "active" : "")" href="@m.Href">@Icon.Svg(m.Icon)<span>@m.Label</span></a></li>
                continue;
            }
            var subs = m.Children.Where(c => c.IsGroup).ToList();
            var loose = m.Children.Where(c => !c.IsGroup).ToList();
            <li class="dropdown">
                <button type="button" class="hnav-link dropdown-toggle @(m.HasActive ? "active" : "")" data-bs-toggle="dropdown" aria-expanded="false">@Icon.Svg(m.Icon)<span>@m.Label</span></button>
                <div class="dropdown-menu hnav-drop @(subs.Count > 0 ? "hnav-mega" : "")">
                    @if (subs.Count == 0)
                    {
                        foreach (var l in loose) { await Item(l); }
                    }
                    else
                    {
                        <div class="hnav-cols">
                            @foreach (var s in subs)
                            {
                                <div class="hnav-col">
                                    <h6 class="dropdown-header">@Icon.Svg(s.Icon, 14) @s.Label</h6>
                                    @foreach (var l in s.Links) { await Item(l); }
                                </div>
                            }
                            @if (loose.Count > 0)
                            {
                                <div class="hnav-col">
                                    <h6 class="dropdown-header">@L["Khác"]</h6>
                                    @foreach (var l in loose) { await Item(l); }
                                </div>
                            }
                        </div>
                    }
                </div>
            </li>
        }
    </ul>
    <div class="dropdown">
        <button type="button" class="hnav-link hnav-search-btn" data-bs-toggle="dropdown" data-bs-auto-close="outside" title="@L["Tìm chức năng"]" aria-label="@L["Tìm chức năng"]">@Icon.Svg("search")</button>
        <div class="dropdown-menu dropdown-menu-end p-2 hnav-search-menu">
            <input type="search" class="form-control form-control-sm" id="hnav-search" placeholder="@L["Tìm chức năng…"]" autocomplete="off" />
            <div id="hnav-results" class="mt-1"></div>
        </div>
    </div>
</nav>

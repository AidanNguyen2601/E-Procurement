@inject Microsoft.Extensions.Options.IOptions<ProcurementSettings> ProcOptions
@inject UiThemeService Themes
@inject SettingsStore SettingsDb
@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var role = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var menu = NavMenu.Build(Url, User, NavMenu.CurrentKey(ViewContext), await SettingsDb.GetAsync(SettingsStore.Permissions, () => new PermissionSettings()));
    var ui = await Themes.ForAsync(User);
    var fontHref = UiTheme.FontHref(ui);
    var pageIcon = ctrl switch { "Home" => "dashboard", "Approvals" => "inbox", "PurchaseRequests" => "file-text", "Items" => "package", "Tenders" => "gavel", "Rfqs" => "send", "DirectAwards" => "award", "Contracts" => "file-check", "PurchaseOrders" => "cart", "GoodsReceipts" => "truck", "Vendors" => "building", "Reports" => "bar-chart", "ReportBuilder" => "sliders", "Catalogs" => "book", "Users" => "users", "SampleData" => "database", "Notifications" => "bell", "Budgets" => "wallet", "ApprovalSettings" => "shield-check", "Invoices" => "receipt", "Payments" => "coins", "Integrations" => "network", "Plans" => "clipboard", "Ordering" => "cart", "Packages" => "package", "SelectionPlans" => "clipboard", "Quotes" => "receipt", "Prequalifications" => "clipboard", "SupplierEvaluations" => "users", "PriceBank" => "database", "StandardPrices" => "tag", "OrgUnits" => "network", "Appearance" => "palette", "Settings" => "settings", "CriteriaSets" => "clipboard", "Categories" => "network", "FormTemplates" => "file-text", "Walkthrough" => "layout", _ => null };
}
<!DOCTYPE html>
<html lang="vi" data-nav="@ui.Nav" data-menu="@ui.Menu" data-accordion="@(ui.Accordion ? "1" : "0")" style="@UiTheme.Style(ui)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="@ui.Color" />
    <link rel="manifest" href="~/manifest.json" />
    <link rel="icon" type="image/svg+xml" href="~/icon.svg" />
    <title>@ViewData["Title"] - E-Procurement</title>
    @if (fontHref != null)
    {
        <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="@fontHref" id="ui-font" />
    }
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-sign="@(ProcOptions.Value.RequireSignature ? "1" : "0")">
<script>try { var s = localStorage.getItem("eproc.nav"); if (s === "mini" || s === "hidden") document.body.classList.add("nav-" + s); } catch (e) { }</script>
<div class="nav-backdrop"></div>
<div class="app">
    <aside class="sidebar">
        <div class="brand-row"><a class="brand" asp-controller="Home" asp-action="Index" title="eProcurement">e<span>Procurement</span></a>
            <button type="button" class="sb-btn" data-nav-mini title="Rút gọn / mở rộng menu (Ctrl+B)" aria-label="Rút gọn menu">@Icon.Svg("chevron-down", 16)</button></div>
        <div class="nav-search"><input type="search" id="nav-search" placeholder="Tìm chức năng…" autocomplete="off" aria-label="Tìm chức năng trong menu" /></div>
        <nav>
            <partial name="_NavVertical" model="menu" />
        </nav>
        <div class="sidebar-foot">
            <button type="button" class="sb-btn" data-nav-expand-all title="Mở rộng tất cả nhóm">⊞ <span>Mở rộng</span></button>
            <button type="button" class="sb-btn" data-nav-collapse-all title="Thu gọn tất cả nhóm">⊟ <span>Thu gọn</span></button>
            <button type="button" class="sb-btn ms-auto" data-nav-hide title="Ẩn menu (Ctrl+B để hiện lại)">⇤ <span>Ẩn</span></button>
        </div>
    </aside>
    <div class="main">
        <partial name="_NavHorizontal" model="menu" />
        <header class="topbar">
            <button type="button" class="btn btn-light nav-toggle" data-nav-toggle aria-label="Ẩn / hiện menu" title="Ẩn / hiện menu (Ctrl+B)">@Icon.Svg("menu", 18)</button>
            <h1 class="page-title d-flex align-items-center gap-2">@if (pageIcon != null) { <span class="text-primary d-inline-flex">@Icon.Svg(pageIcon, 20)</span> }@ViewData["Title"]</h1>
            <div class="d-flex align-items-center gap-2">
                <a class="btn btn-primary btn-sm" asp-controller="PurchaseRequests" asp-action="Create">@Icon.Svg("plus", 14)<span>Đề nghị mua hàng</span></a>
                @await Component.InvokeAsync("NotificationBell")
                <div class="dropdown">
                    <button class="btn btn-light dropdown-toggle" data-bs-toggle="dropdown">
                        <span class="avatar">@(User.GetFullName().Length > 0 ? char.ToUpper(User.GetFullName().Split(' ').Last()[0]) : '?')</span>
                        @User.GetFullName() <small class="text-muted">(@AppRoles.DisplayName(role) · @User.GetDepartment())</small>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        @foreach (var from in User.DelegatedFrom()) { <li><span class="dropdown-item-text small text-success">Đang được ủy quyền duyệt thay: @from</span></li> }
                        <li><a class="dropdown-item" asp-controller="Notifications" asp-action="Index">Thông báo</a></li>
                        @if (!User.IsAdmin() && (User.IsInRole(AppRoles.Director) || User.IsInRole(AppRoles.Approver))) { <li><a class="dropdown-item" asp-controller="ApprovalSettings" asp-action="Index">Ủy quyền duyệt</a></li> }
                        <li><a class="dropdown-item" asp-controller="Walkthrough" asp-action="Index">Kịch bản nghiệp vụ</a></li>
                        <li><a class="dropdown-item" asp-controller="Appearance" asp-action="Index">Giao diện</a></li>
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item text-danger">Đăng xuất</button></form></li>
                    </ul>
                </div>
            </div>
        </header>
        <main class="content">
            @if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show">@ok<button class="btn-close" data-bs-dismiss="alert"></button></div> }
            @if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show">@err<button class="btn-close" data-bs-dismiss="alert"></button></div> }
            @RenderBody()
        </main>
        <footer class="footer">&copy; @DateTime.Now.Year E-Procurement — ASP.NET Core 8 MVC + SQL Server</footer>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

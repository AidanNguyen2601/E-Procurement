@model List<SelectionPlan>
@{
    ViewData["Title"] = "Kế hoạch lựa chọn nhà cung cấp";
    var status = ViewBag.Status as SelectionPlanStatus?; int unplanned = ViewBag.Unplanned;
    var statusItems = Html.GetEnumSelectList<SelectionPlanStatus>().ToList();
    foreach (var i in statusItems) i.Selected = status.HasValue && i.Value == ((int)status.Value).ToString();
}
@if (unplanned > 0 && User.IsPurchasing())
{
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-2">@Icon.Svg("clipboard", 16) <span><b>@unplanned</b> @L["gói mua sắm chưa được đưa vào kế hoạch lựa chọn NCC."]</span>
        <a asp-action="Create" class="btn btn-sm btn-primary ms-auto">@L["Lập KHLCNT"]</a></div>
}
<form method="get" class="toolbar">
    <select name="status" class="form-select form-select-sm" style="width:auto" asp-items="statusItems" onchange="this.form.submit()"><option value="">@L["-- Mọi trạng thái --"]</option></select>
    @if (User.IsPurchasing()) { <a asp-action="Create" class="btn btn-sm btn-primary ms-auto">@Icon.Svg("plus", 14) @L["Lập KHLCNT"]</a> }
</form>
<div class="card"><div class="card-body p-0"><div class="table-responsive"><table class="table mb-0 align-middle">
    <thead><tr><th>@L["Số"]</th><th>@L["Tên kế hoạch"]</th><th class="money">@L["Số gói"]</th><th class="money">@L["Tổng giá gói"]</th><th>@L["Người lập"]</th><th>@L["Phê duyệt"]</th><th>@L["Trạng thái"]</th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr><td><a asp-action="Details" asp-route-id="@p.Id" class="fw-semibold">@p.Number</a><br /><small class="text-muted">@p.CreatedAt.ToDate()</small></td>
            <td>@p.Title</td><td class="money">@p.Packages.Count</td><td class="money">@p.Packages.Sum(x => x.Budget).ToMoney()</td>
            <td class="small">@p.CreatedBy?.FullName</td><td class="small">@p.DecidedAt?.ToString("dd/MM/yyyy")</td>
            <td><partial name="_Badge" model="p.Status" /></td></tr>
    }
    @if (!Model.Any()) { <tr><td colspan="7" class="text-muted p-3">@L["Chưa có kế hoạch lựa chọn nhà cung cấp."]</td></tr> }
    </tbody>
</table></div></div></div>

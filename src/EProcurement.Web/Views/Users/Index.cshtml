@model List<AppUser>
@{ ViewData["Title"] = "Người dùng & phân quyền"; }
<div class="toolbar"><a class="btn btn-primary" asp-action="Create">@L["+ Thêm người dùng"]</a></div>
<div class="card"><div class="card-body p-0"><table class="table table-hover mb-0">
    <thead><tr><th>@L["Tên đăng nhập"]</th><th>@L["Họ tên"]</th><th>@L["Phòng ban"]</th><th>Email</th><th>@L["Vai trò"]</th><th>@L["Trạng thái"]</th><th>@L["Đăng nhập gần nhất"]</th><th></th></tr></thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr><td><b>@u.Username</b></td><td>@u.FullName</td><td>@u.Department</td><td>@u.Email</td>
            <td><span class="badge bg-primary">@AppRoles.DisplayName(u.Role)</span></td>
            <td>@(u.IsActive ? Html.Raw("<span class='badge bg-success'>" + L["Hoạt động"] + "</span>") : Html.Raw("<span class='badge bg-secondary'>" + L["Đã khóa"] + "</span>"))</td>
            <td>@u.LastLoginAt?.ToString("dd/MM/yyyy HH:mm")</td>
            <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@u.Id">@L["Sửa"]</a></td></tr>
    }
    </tbody>
</table></div></div>
<div class="card mt-3"><div class="card-body small">
    <b>@L["Phân quyền:"]</b>
    <ul class="mb-0">
        <li><b>@L["Người đề nghị"]</b>@L[": tạo, gửi duyệt, theo dõi đề nghị mua hàng của mình."]</li>
        <li><b>@L["Trưởng bộ phận"]</b>@L[": duyệt cấp 1 đề nghị của phòng mình."]</li>
        <li><b>@L["Ban Giám đốc"]</b>@L[": duyệt cấp 2 đề nghị vượt ngưỡng và đơn mua hàng vượt ngưỡng; xem toàn bộ mua sắm."]</li>
        <li><b>@L["Nhân viên mua hàng"]</b>@L[": quản lý NCC, hàng hóa, RFQ, so sánh báo giá, PO, nhận hàng, đánh giá NCC."]</li>
        <li><b>@L["Quản trị hệ thống"]</b>@L[": toàn quyền, quản lý người dùng."]</li>
    </ul>
    <div class="mt-2 text-muted">@L["Ngưỡng duyệt cấu hình trong appsettings.json → Procurement."]</div>
</div></div>
